{% doc %}
  @prompt
    Make a dual image banner section each image has it's own link setting and shall be responsive
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-dual-banner-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-dual-banner-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-dual-banner-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-dual-banner-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-dual-banner-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-dual-banner-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-dual-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-dual-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%
    );
    pointer-events: none;
  }

  .ai-dual-banner-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.content_padding }}px;
    left: {{ block.settings.content_padding }}px;
    right: {{ block.settings.content_padding }}px;
    color: {{ block.settings.text_color }};
    z-index: 1;
  }

  .ai-dual-banner-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-dual-banner-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    line-height: 1.4;
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .ai-dual-banner-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-dual-banner-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-dual-banner-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-dual-banner-content-{{ ai_gen_id }} {
      bottom: {{ block.settings.content_padding | times: 0.7 }}px;
      left: {{ block.settings.content_padding | times: 0.7 }}px;
      right: {{ block.settings.content_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-dual-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-banner-container-{{ ai_gen_id }}">
    <div class="ai-dual-banner-item-{{ ai_gen_id }}">
      {% if block.settings.link_1 != blank %}
        <a href="{{ block.settings.link_1 }}" class="ai-dual-banner-link-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-dual-banner-link-{{ ai_gen_id }}">
      {% endif %}
        <div class="ai-dual-banner-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_1 %}
            <img
              src="{{ block.settings.image_1 | image_url: width: 1000 }}"
              alt="{{ block.settings.image_1.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_1.width }}"
              height="{{ block.settings.image_1.height }}"
              class="ai-dual-banner-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-dual-banner-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% if block.settings.show_overlay %}
            <div class="ai-dual-banner-overlay-{{ ai_gen_id }}"></div>
          {% endif %}
          {% if block.settings.title_1 != blank or block.settings.subtitle_1 != blank %}
            <div class="ai-dual-banner-content-{{ ai_gen_id }}">
              {% if block.settings.title_1 != blank %}
                <h3 class="ai-dual-banner-title-{{ ai_gen_id }}">{{ block.settings.title_1 }}</h3>
              {% endif %}
              {% if block.settings.subtitle_1 != blank %}
                <p class="ai-dual-banner-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle_1 }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% if block.settings.link_1 != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    </div>

    <div class="ai-dual-banner-item-{{ ai_gen_id }}">
      {% if block.settings.link_2 != blank %}
        <a href="{{ block.settings.link_2 }}" class="ai-dual-banner-link-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-dual-banner-link-{{ ai_gen_id }}">
      {% endif %}
        <div class="ai-dual-banner-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_2 %}
            <img
              src="{{ block.settings.image_2 | image_url: width: 1000 }}"
              alt="{{ block.settings.image_2.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_2.width }}"
              height="{{ block.settings.image_2.height }}"
              class="ai-dual-banner-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-dual-banner-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% if block.settings.show_overlay %}
            <div class="ai-dual-banner-overlay-{{ ai_gen_id }}"></div>
          {% endif %}
          {% if block.settings.title_2 != blank or block.settings.subtitle_2 != blank %}
            <div class="ai-dual-banner-content-{{ ai_gen_id }}">
              {% if block.settings.title_2 != blank %}
                <h3 class="ai-dual-banner-title-{{ ai_gen_id }}">{{ block.settings.title_2 }}</h3>
              {% endif %}
              {% if block.settings.subtitle_2 != blank %}
                <p class="ai-dual-banner-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle_2 }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% if block.settings.link_2 != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dual image banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "First banner"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title",
      "default": "Banner 1"
    },
    {
      "type": "text",
      "id": "subtitle_1",
      "label": "Subtitle",
      "default": "Shop now"
    },
    {
      "type": "header",
      "content": "Second banner"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title",
      "default": "Banner 2"
    },
    {
      "type": "text",
      "id": "subtitle_2",
      "label": "Subtitle",
      "default": "Discover more"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between banners",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap on mobile",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "aspect_ratio",
      "label": "Image height",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show gradient overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Dual image banner"
    }
  ]
}
{% endschema %}
