{% doc %}
  @prompt
    Add delivery estimate
    No “ships in X days” or arrival date anywhere. Uncertainty blocks at this price., can it be dynamic
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign delivery_metafield = product.metafields.custom.delivery_estimate.value %}
{% assign delivery_copy = delivery_metafield | default: block.settings.estimate %}

{% style %}
  .ai-delivery-estimate-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 14px 16px;
    border: 1px solid {{ block.settings.border_color }};
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: inherit;
    font-size: 14px;
    line-height: 1.5;
  }
  .ai-delivery-estimate-{{ ai_gen_id }}__row { display: flex; align-items: flex-start; gap: 12px; }
  .ai-delivery-estimate-{{ ai_gen_id }}__icon { flex: 0 0 20px; width: 20px; height: 20px; margin-top: 1px; color: {{ block.settings.icon_color }}; }
  .ai-delivery-estimate-{{ ai_gen_id }}__copy { min-width: 0; }
  .ai-delivery-estimate-{{ ai_gen_id }}__heading { display: block; margin: 0 0 2px; color: {{ block.settings.text_color }}; font-size: 14px; font-weight: 600; }
  .ai-delivery-estimate-{{ ai_gen_id }}__detail { margin: 0; }
  .ai-delivery-estimate-{{ ai_gen_id }}__note { margin: 4px 0 0; font-size: 12px; }
{% endstyle %}

<div class="ai-delivery-estimate-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-delivery-estimate-{{ ai_gen_id }}__row">
    <svg class="ai-delivery-estimate-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 6.5h11v11H3zM14 10h4l3 3v4h-7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <circle cx="7.5" cy="18" r="1.8" fill="{{ block.settings.background_color }}" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="18" cy="18" r="1.8" fill="{{ block.settings.background_color }}" stroke="currentColor" stroke-width="1.7"/>
    </svg>
    <div class="ai-delivery-estimate-{{ ai_gen_id }}__copy">
      {% if block.settings.heading != blank %}<strong class="ai-delivery-estimate-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</strong>{% endif %}
      {% if delivery_copy != blank %}<p class="ai-delivery-estimate-{{ ai_gen_id }}__detail">{{ delivery_copy | escape }}</p>{% endif %}
      {% if block.settings.note != blank %}<p class="ai-delivery-estimate-{{ ai_gen_id }}__note">{{ block.settings.note | escape }}</p>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Delivery estimate",
  "settings": [
    { "type": "header", "content": "Delivery details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery estimate" },
    { "type": "text", "id": "estimate", "label": "Fallback estimate", "default": "Delivery timing varies by product and location." },
    { "type": "paragraph", "content": "For product-specific text, create a product metafield with namespace and key custom.delivery_estimate (single-line text). Its value will override the fallback." },
    { "type": "text", "id": "note", "label": "Additional note", "default": "Exact timing depends on your delivery location." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#000000" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E6E6E6" }
  ],
  "presets": [{ "name": "Delivery estimate" }],
  "tag": null,
  "class": "delivery-estimate-block"
}
{% endschema %}