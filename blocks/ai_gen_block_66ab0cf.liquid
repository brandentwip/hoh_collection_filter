{% doc %}
  @prompt
    Trust row directly under Add to cart
    Free shipping,size exchange available, COD — currently only small grey text “Taxes and Standard Shipping Included”
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-row-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 12px 0 0;
    color: {{ block.settings.text_color }};
    font-family: inherit;
  }

  .ai-trust-row-{{ ai_gen_id }}__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 18px;
    padding: 12px 0;
    border-top: 1px solid {{ block.settings.border_color }};
  }

  .ai-trust-row-{{ ai_gen_id }}__item {
    display: inline-flex;
    flex: 1 1 120px;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 13px;
    line-height: 1.4;
  }

  .ai-trust-row-{{ ai_gen_id }}__icon {
    display: inline-flex;
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-trust-row-{{ ai_gen_id }}__icon svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (max-width: 600px) {
    .ai-trust-row-{{ ai_gen_id }}__items {
      justify-content: flex-start;
      gap: 10px 14px;
    }

    .ai-trust-row-{{ ai_gen_id }}__item {
      flex-basis: calc(50% - 14px);
      font-size: 12px;
    }
  }
{% endstyle %}

<div class="ai-trust-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-row-{{ ai_gen_id }}__items" aria-label="Shopping benefits">
    {% if block.settings.shipping_text != blank %}
      <div class="ai-trust-row-{{ ai_gen_id }}__item">
        <span class="ai-trust-row-{{ ai_gen_id }}__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M3 6h11v11H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7.5" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/></svg>
        </span>
        <span>{{ block.settings.shipping_text | escape }}</span>
      </div>
    {% endif %}
    {% if block.settings.exchange_text != blank %}
      <div class="ai-trust-row-{{ ai_gen_id }}__item">
        <span class="ai-trust-row-{{ ai_gen_id }}__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20 7v5h-5"/><path d="M4 17v-5h5"/><path d="M5.6 9a7 7 0 0 1 11.6-2L20 12M4 12l2.8 5a7 7 0 0 0 11.6-2"/></svg>
        </span>
        <span>{{ block.settings.exchange_text | escape }}</span>
      </div>
    {% endif %}
    {% if block.settings.cod_text != blank %}
      <div class="ai-trust-row-{{ ai_gen_id }}__item">
        <span class="ai-trust-row-{{ ai_gen_id }}__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h3"/></svg>
        </span>
        <span>{{ block.settings.cod_text | escape }}</span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Purchase trust row",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping message",
      "default": "Free shipping"
    },
    {
      "type": "text",
      "id": "exchange_text",
      "label": "Exchange message",
      "default": "Size exchange available"
    },
    {
      "type": "text",
      "id": "cod_text",
      "label": "Payment message",
      "default": "Cash on delivery"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#2A555A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#D9D9D9"
    }
  ],
  "presets": [
    {
      "name": "Purchase trust row"
    }
  ],
  "tag": null,
  "class": "purchase-trust-row"
}
{% endschema %}