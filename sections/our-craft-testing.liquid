{%- comment -%}
  ourcrafttest — single-file section for Haus of Handmade.
  Upload to: sections/ourcrafttest.liquid
  Includes: Ethos, Details you feel, Why it matters, One piece every hour (3 times of day).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" rel="stylesheet">

{%- assign ethos_items = section.blocks | where: 'type', 'ethos' -%}
{%- assign detail_items = section.blocks | where: 'type', 'detail' -%}
{%- assign benefit_items = section.blocks | where: 'type', 'benefit' -%}
{%- assign hour_items = section.blocks | where: 'type', 'hour' -%}
{%- assign hour_alt_items = section.blocks | where: 'type', 'hour_alt' -%}

<div class="oc" style="--oc-accent: {{ section.settings.accent_color | default: '#A8553A' }};">

  {%- comment -%} OUR ETHOS {%- endcomment -%}
  {%- if ethos_items.size > 0 -%}
    <section class="oc-white oc-ethos">
      <div class="oc-wrap">
        <p class="oc-eyebrow">{{ section.settings.ethos_eyebrow | escape }}</p>
        <h2 class="oc-h2">{{ section.settings.ethos_heading | escape }} <em>{{ section.settings.ethos_heading_em | escape }}</em></h2>
        <div class="oc-ethos__grid">
          {%- for block in ethos_items -%}
            <div class="oc-card" {{ block.shopify_attributes }}>
              <svg class="oc-icon" viewBox="0 0 54 54" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'rings' -%}<circle cx="27" cy="27" r="6"/><circle cx="27" cy="27" r="14"/><circle cx="27" cy="27" r="22" stroke-dasharray="3 5"/>
                  {%- when 'cross' -%}<path d="M10 40 L44 14"/><path d="M10 14 L44 40" stroke-dasharray="2 5"/><circle cx="27" cy="27" r="4"/>
                  {%- when 'leaf' -%}<path d="M27 8 C 17 22, 17 34, 27 46 C 37 34, 37 22, 27 8Z"/><path d="M27 14 V46"/>
                  {%- when 'star' -%}<path d="M27 8 L32 22 L46 22 L35 31 L39 45 L27 36 L15 45 L19 31 L8 22 L22 22Z"/>
                {%- endcase -%}
              </svg>
              <h3 class="oc-card__title">{{ block.settings.title | escape }}</h3>
              <p class="oc-card__text">{{ block.settings.text | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} THE DETAILS YOU FEEL {%- endcomment -%}
  {%- if detail_items.size > 0 -%}
    <section class="oc-white oc-details">
      <div class="oc-wrap oc-wrap--wide">
        <p class="oc-eyebrow">{{ section.settings.details_eyebrow | escape }}</p>
        <h2 class="oc-h2">{{ section.settings.details_heading | escape }} <em>{{ section.settings.details_heading_em | escape }}</em></h2>
        <div class="oc-details__gallery">
          {%- for block in detail_items -%}
            <figure class="oc-frame" {{ block.shopify_attributes }}>
              {%- case block.settings.illustration -%}
                {%- when 'weave' -%}
                  <svg viewBox="0 0 300 340" role="img" aria-label="Woven fabric texture">
                    <defs><pattern id="oc-weave-{{ section.id }}-{{ block.id }}" width="20" height="20" patternUnits="userSpaceOnUse"><path class="oc-stroke" d="M0 5H20M0 15H20" stroke-width="3" opacity=".55"/><path class="oc-stroke" d="M5 0V20M15 0V20" stroke-width="3" opacity=".25"/></pattern></defs>
                    <rect width="300" height="340" fill="url(#oc-weave-{{ section.id }}-{{ block.id }})"/>
                  </svg>
                {%- when 'hem' -%}
                  <svg viewBox="0 0 300 340" role="img" aria-label="Hand-finished hem stitching">
                    <rect class="oc-fill" x="0" y="0" width="300" height="210" opacity=".2"/>
                    <rect class="oc-fill" x="0" y="210" width="300" height="130" opacity=".38"/>
                    <path class="oc-stroke" d="M0 210H300" stroke-width="2" fill="none"/>
                    <path d="M-4 232H304" class="oc-stitch"/>
                  </svg>
                {%- when 'button' -%}
                  <svg viewBox="0 0 300 340" role="img" aria-label="Sewn button">
                    <circle class="oc-fill" cx="150" cy="170" r="74" opacity=".22"/>
                    <circle class="oc-stroke" cx="150" cy="170" r="74" fill="none" stroke-width="3"/>
                    <circle class="oc-stroke" cx="150" cy="170" r="52" fill="none" stroke-width="1.5" opacity=".6"/>
                    <g class="oc-stroke" fill="#fff" stroke-width="2"><circle cx="132" cy="152" r="7"/><circle cx="168" cy="152" r="7"/><circle cx="132" cy="188" r="7"/><circle cx="168" cy="188" r="7"/></g>
                    <path class="oc-stroke" d="M132 152L168 188M168 152L132 188" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                  </svg>
              {%- endcase -%}
              <figcaption>{{ block.settings.caption | escape }}</figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} WHY IT MATTERS {%- endcomment -%}
  {%- if benefit_items.size > 0 -%}
    <section class="oc-white oc-why">
      <div class="oc-wrap">
        <p class="oc-eyebrow">{{ section.settings.why_eyebrow | escape }}</p>
        <h2 class="oc-h2">{{ section.settings.why_heading | escape }} <em>{{ section.settings.why_heading_em | escape }}</em></h2>
        <ul class="oc-benefits">
          {%- for block in benefit_items -%}
            <li {{ block.shopify_attributes }}>
              <span class="oc-benefits__tick" aria-hidden="true">✓</span>
              <div>
                <b>{{ block.settings.title | escape }}</b>
                <span>{{ block.settings.text | escape }}</span>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ONE PIECE, EVERY HOUR — two versions. A: buttons below the scene. B: buttons on the right. {%- endcomment -%}
  {%- for variant in (1..2) -%}
    {%- if variant == 1 -%}
      {%- assign items = hour_items -%}
      {%- assign p = 'hours' -%}
      {%- assign layout = 'oc-hours--stack' -%}
    {%- else -%}
      {%- assign items = hour_alt_items -%}
      {%- assign p = 'hours2' -%}
      {%- assign layout = 'oc-hours--side' -%}
    {%- endif -%}
    {%- assign k_eyebrow = p | append: '_eyebrow' -%}
    {%- assign k_heading = p | append: '_heading' -%}
    {%- assign k_heading_em = p | append: '_heading_em' -%}
    {%- assign k_sub = p | append: '_sub' -%}
    {%- if items.size > 0 -%}
      {%- assign first_hour = items | first -%}
      <section class="oc-white oc-hours {{ layout }}" id="oc-hours-{{ section.id }}-{{ variant }}">
        <div class="oc-wrap oc-wrap--wide">
          <p class="oc-eyebrow">{{ section.settings[k_eyebrow] | escape }}</p>
          <h2 class="oc-h2">{{ section.settings[k_heading] | escape }} <em>{{ section.settings[k_heading_em] | escape }}</em></h2>
          {%- if section.settings[k_sub] != blank -%}<p class="oc-hours__sub">{{ section.settings[k_sub] | escape }}</p>{%- endif -%}

          <div class="oc-hours__layout">
            <div class="oc-scene {{ first_hour.settings.time }}" data-scene>
              <div class="oc-sky morning{% if first_hour.settings.time == 'morning' %} on{% endif %}"></div>
              <div class="oc-sky midday{% if first_hour.settings.time == 'midday' %} on{% endif %}"></div>
              <div class="oc-sky evening{% if first_hour.settings.time == 'evening' %} on{% endif %}"></div>
              <div class="oc-orb"></div>
              <div class="oc-ground"></div>
              <svg viewBox="0 0 200 240" role="img" aria-label="The same garment shown through the day">
                <path class="g oc-fill" d="M70 30 Q100 50 130 30 L172 52 L156 88 L138 76 L138 200 L62 200 L62 76 L44 88 L28 52 Z" stroke-width="1.5" stroke-linejoin="round"/>
                <path class="g" d="M70 30 Q100 56 130 30" fill="none" stroke-width="1.5"/>
                <path d="M62 190H138" fill="none" stroke="#fff" stroke-width="1.8" stroke-dasharray="5 5"/>
              </svg>
            </div>

            <div class="oc-hours__side">
              <div class="oc-times" data-times>
                {%- for block in items -%}
                  <button type="button" class="oc-opt" data-t="{{ block.settings.time }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>
                {%- endfor -%}
              </div>

              <div class="oc-tinfo" data-info aria-live="polite">
                <h3>{{ first_hour.settings.title | escape }}</h3>
                <p><b>Wear it to:</b> {{ first_hour.settings.wear | escape }}</p>
                <p><b>Style it with:</b> {{ first_hour.settings.style | escape }}</p>
              </div>
            </div>
          </div>

          <script type="application/json" data-hours>
            {
              {%- for block in items -%}
                {{ block.settings.time | json }}: [{{ block.settings.title | json }}, {{ block.settings.wear | json }}, {{ block.settings.style | json }}]{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            }
          </script>
          <script>
            (function () {
              var root = document.getElementById('oc-hours-{{ section.id }}-{{ variant }}');
              if (!root) return;
              var scene = root.querySelector('[data-scene]');
              var box = root.querySelector('[data-times]');
              var info = root.querySelector('[data-info]');
              var skies = scene.querySelectorAll('.oc-sky');
              var data = {};
              try { data = JSON.parse(root.querySelector('[data-hours]').textContent); } catch (e) {}
              function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
              box.addEventListener('click', function (e) {
                var b = e.target.closest('button');
                if (!b || !data[b.dataset.t]) return;
                var t = b.dataset.t;
                [].forEach.call(box.children, function (x) { x.setAttribute('aria-pressed', 'false'); });
                b.setAttribute('aria-pressed', 'true');
                scene.className = 'oc-scene ' + t;
                [].forEach.call(skies, function (x) { x.classList.toggle('on', x.classList.contains(t)); });
                var d = data[t];
                info.innerHTML = '<h3>' + esc(d[0]) + '</h3><p><b>Wear it to:</b> ' + esc(d[1]) + '</p><p><b>Style it with:</b> ' + esc(d[2]) + '</p>';
              });
            })();
          </script>
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  :root { --oc-bg:#FAF8F5; --oc-dark:#1A1A18; --oc-mid:#6B6560; --oc-line:rgba(26,26,24,0.1); --oc-serif:'Inter',system-ui,sans-serif; --oc-sans:'Inter',system-ui,sans-serif; }
  .oc, .oc *, .oc *::before, .oc *::after { box-sizing: border-box; }
  .oc { --oc-accent: #A8553A; background: #fff; color: var(--oc-dark); font-family: var(--oc-sans); font-weight: 300; }
  .oc img, .oc svg.placeholder { display: block; width: 100%; }
  .oc h2, .oc h3, .oc p { margin: 0; }

  .oc-white { background: #fff; padding: 96px 24px; border-top: 1px solid var(--oc-line); }
  .oc-white:first-child { border-top: none; }
  .oc-wrap { max-width: 760px; margin: 0 auto; }
  .oc-wrap--wide { max-width: 1040px; }
  .oc-eyebrow { font-size: 11px; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; color: var(--oc-accent); margin-bottom: 18px; }
  .oc-h2 { font-family: var(--oc-serif); font-size: clamp(30px, 5vw, 46px); font-weight: 400; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 24px; }
  .oc-h2 em { font-style: italic; color: var(--oc-accent); }

  .oc-ethos__grid { display: grid; gap: 20px; margin-top: 36px; grid-template-columns: 1fr 1fr; }
  .oc-card { background: var(--oc-bg); padding: 30px 26px; border: 1px solid var(--oc-line); border-radius: 4px; }
  .oc-icon { width: 54px; height: 54px; margin-bottom: 14px; display: block; }
  .oc-icon * { stroke: var(--oc-accent); stroke-width: 1.6; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .oc-card__title { font-family: var(--oc-serif); font-weight: 500; font-size: 22px; margin-bottom: 8px; letter-spacing: -0.01em; }
  .oc-card__text { color: var(--oc-mid); font-size: 14px; line-height: 1.8; }

  .oc-details__gallery { display: grid; gap: 18px; margin-top: 32px; grid-template-columns: repeat(3, 1fr); }
  .oc-frame { background: var(--oc-bg); border: 1px solid var(--oc-line); border-radius: 4px; overflow: hidden; margin: 0; }
  .oc-frame svg { display: block; width: 100%; height: auto; }
  .oc-frame figcaption { padding: 14px 18px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--oc-mid); border-top: 1px solid var(--oc-line); background: #fff; }
  .oc-stroke { stroke: var(--oc-accent); }
  .oc-fill { fill: var(--oc-accent); }
  .oc-stitch { stroke: var(--oc-accent); stroke-width: 2; fill: none; stroke-dasharray: 7 9; stroke-linecap: round; animation: oc-run 5s linear infinite; }
  @keyframes oc-run { to { stroke-dashoffset: -64; } }
  @media (prefers-reduced-motion: reduce) { .oc-stitch { animation: none; } .oc-sky, .oc-orb { transition: none !important; } }

  .oc-benefits { list-style: none; padding: 0; margin: 34px 0 0; display: grid; gap: 16px; }
  .oc-benefits li { display: grid; grid-template-columns: 34px 1fr; gap: 12px; align-items: start; padding: 20px 22px; background: var(--oc-bg); border: 1px solid var(--oc-line); border-radius: 4px; }
  .oc-benefits__tick { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--oc-accent); color: var(--oc-accent); font-size: 15px; }
  .oc-benefits b { display: block; font-family: var(--oc-serif); font-weight: 500; font-size: 20px; line-height: 1.3; letter-spacing: -0.01em; margin-bottom: 4px; }
  .oc-benefits li > div > span { color: var(--oc-mid); font-size: 14px; line-height: 1.75; display: block; }

  /* One piece, every hour */
  .oc-hours__sub { color: var(--oc-mid); max-width: 560px; font-size: 14px; line-height: 1.8; }
  .oc-hours__layout { margin-top: 30px; }
  .oc-scene { position: relative; height: 320px; border-radius: 4px; overflow: hidden; border: 1px solid var(--oc-line); --gs: #1A1A18; }
  .oc-sky { position: absolute; inset: 0; opacity: 0; transition: opacity .9s ease; }
  .oc-sky.on { opacity: 1; }
  .oc-sky.morning { background: linear-gradient(#f6d9b8, #fbeee0); }
  .oc-sky.midday { background: linear-gradient(#a9d3ea, #eaf5fa); }
  .oc-sky.evening { background: linear-gradient(#e08a5b, #f3c48a 60%, #f6e1c3); }
  .oc-orb { position: absolute; width: 56px; height: 56px; border-radius: 50%; background: #fff4c9; box-shadow: 0 0 50px 16px rgba(255,236,170,.6); transition: left .9s ease, top .9s ease, background .9s ease, box-shadow .9s ease; left: 12%; top: 58%; }
  .oc-scene.midday .oc-orb { left: 46%; top: 6%; background: #fffbe0; }
  .oc-scene.evening .oc-orb { left: 76%; top: 52%; background: #ffb27a; box-shadow: 0 0 50px 16px rgba(255,160,100,.55); }
  .oc-ground { position: absolute; left: 0; right: 0; bottom: 0; height: 34px; background: rgba(0,0,0,.14); }
  .oc-scene svg { position: absolute; left: 50%; bottom: 22px; width: 170px; height: auto; transform: translateX(-50%); }
  .oc-scene svg path.g { stroke: var(--gs); }
  .oc-tinfo { background: var(--oc-bg); border: 1px solid var(--oc-line); border-radius: 4px; padding: 24px 24px 20px; }
  .oc-tinfo h3 { font-family: var(--oc-serif); font-weight: 500; font-size: 24px; letter-spacing: -0.01em; margin-bottom: 8px; }
  .oc-tinfo p { margin: 0 0 8px; color: var(--oc-mid); font-size: 14px; line-height: 1.75; }
  .oc-tinfo p b { color: var(--oc-dark); font-weight: 500; }

  /* Version A: original layout, buttons in a row below the scene */
  .oc-hours--stack .oc-times { display: flex; gap: 10px; flex-wrap: wrap; margin: 22px 0 18px; }
  .oc-hours--stack .oc-opt { font: inherit; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; padding: 12px 20px; border: 1px solid var(--oc-line); background: #fff; color: var(--oc-dark); border-radius: 2px; cursor: pointer; }
  .oc-hours--stack .oc-opt[aria-pressed="true"] { outline: 2px solid var(--oc-accent); outline-offset: 2px; }

  /* Version B: scene left, buttons + info on the right */
  .oc-hours--side .oc-hours__layout { display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: stretch; }
  .oc-hours--side .oc-scene { height: auto; min-height: 380px; }
  .oc-hours--side .oc-scene svg { width: 190px; }
  .oc-hours--side .oc-hours__side { display: flex; flex-direction: column; gap: 16px; }
  .oc-hours--side .oc-times { display: flex; flex-direction: column; gap: 10px; }
  .oc-hours--side .oc-opt { font: inherit; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; text-align: left; padding: 16px 22px; border: 1px solid var(--oc-line); background: #fff; color: var(--oc-dark); border-radius: 2px; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .oc-hours--side .oc-opt:hover { border-color: var(--oc-accent); }
  .oc-hours--side .oc-opt[aria-pressed="true"] { background: var(--oc-accent); border-color: var(--oc-accent); color: #fff; }
  .oc-hours--side .oc-tinfo { flex: 1; }

  @media (max-width: 768px) {
    .oc-white { padding: 64px 20px; }
    .oc-ethos__grid { grid-template-columns: 1fr; }
    .oc-details__gallery { grid-template-columns: 1fr; }
    .oc-hours--side .oc-hours__layout { grid-template-columns: 1fr; }
    .oc-hours--side .oc-scene { min-height: 320px; }
    .oc-hours--side .oc-hours__side { margin-top: 0; }
    .oc-hours--side .oc-times { flex-direction: row; flex-wrap: wrap; }
    .oc-hours--side .oc-opt { flex: 1 1 auto; text-align: center; padding: 14px 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ourcrafttest",
  "settings": [
    { "type": "header", "content": "Accent colour" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#A8553A" },

    { "type": "header", "content": "Our ethos" },
    { "type": "text", "id": "ethos_eyebrow", "label": "Eyebrow", "default": "Our Ethos" },
    { "type": "text", "id": "ethos_heading", "label": "Heading", "default": "Four quiet" },
    { "type": "text", "id": "ethos_heading_em", "label": "Heading (accent word)", "default": "promises" },

    { "type": "header", "content": "The details you feel" },
    { "type": "text", "id": "details_eyebrow", "label": "Eyebrow", "default": "Up Close" },
    { "type": "text", "id": "details_heading", "label": "Heading", "default": "The" },
    { "type": "text", "id": "details_heading_em", "label": "Heading (accent word)", "default": "details you feel" },

    { "type": "header", "content": "Why it matters" },
    { "type": "text", "id": "why_eyebrow", "label": "Eyebrow", "default": "Why It Matters" },
    { "type": "text", "id": "why_heading", "label": "Heading", "default": "What this means" },
    { "type": "text", "id": "why_heading_em", "label": "Heading (accent word)", "default": "for you" },

    { "type": "header", "content": "One piece, every hour (1st)" },
    { "type": "text", "id": "hours_eyebrow", "label": "Eyebrow", "default": "Versatility" },
    { "type": "text", "id": "hours_heading", "label": "Heading", "default": "One piece," },
    { "type": "text", "id": "hours_heading_em", "label": "Heading (accent word)", "default": "every hour" },
    { "type": "textarea", "id": "hours_sub", "label": "Subtext", "default": "The same garment, from the first coffee to the last light. Choose a time of day and see how it moves with you." },

    { "type": "header", "content": "One piece, every hour (2nd)" },
    { "type": "text", "id": "hours2_eyebrow", "label": "Eyebrow", "default": "Versatility" },
    { "type": "text", "id": "hours2_heading", "label": "Heading", "default": "One piece," },
    { "type": "text", "id": "hours2_heading_em", "label": "Heading (accent word)", "default": "every hour" },
    { "type": "textarea", "id": "hours2_sub", "label": "Subtext", "default": "The same garment, from the first coffee to the last light. Choose a time of day and see how it moves with you." }
  ],
  "blocks": [
    {
      "type": "ethos",
      "name": "Ethos card",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "rings",
          "options": [
            { "value": "rings", "label": "Rings" },
            { "value": "cross", "label": "Crossed lines" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Small batch" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this promise." }
      ]
    },
    {
      "type": "detail",
      "name": "Detail illustration",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "illustration", "label": "Illustration", "default": "weave",
          "options": [
            { "value": "weave", "label": "Woven fabric" },
            { "value": "hem", "label": "Hand-finished hem" },
            { "value": "button", "label": "Sewn button" }
          ] },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Light, breathable weave" }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this benefit." }
      ]
    },
    {
      "type": "hour",
      "name": "Time of day (1st section)",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "time", "label": "Scene", "default": "morning",
          "options": [
            { "value": "morning", "label": "Morning" },
            { "value": "midday", "label": "Noon" },
            { "value": "evening", "label": "Evening" }
          ] },
        { "type": "text", "id": "label", "label": "Button label", "default": "Morning" },
        { "type": "text", "id": "title", "label": "Title", "default": "A slow, easy start" },
