{%- comment -%}
  Our Craft — single-file section for Haus of Handmade.
  Upload to: sections/our-craft.liquid
  Includes: Ethos, Details, Why it matters, Hours (one piece, every hour).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" rel="stylesheet">

{%- assign rows = section.blocks | where: 'type', 'row' -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- assign trust_items = section.blocks | where: 'type', 'trust' -%}
{%- assign ethos_items = section.blocks | where: 'type', 'ethos' -%}
{%- assign detail_items = section.blocks | where: 'type', 'detail' -%}
{%- assign benefit_items = section.blocks | where: 'type', 'benefit' -%}
{%- assign hour_items = section.blocks | where: 'type', 'hour' -%}

<div class="oc" style="--oc-hero-h: {{ section.settings.hero_height }}; --oc-hero-opacity: {{ section.settings.hero_opacity | divided_by: 100.0 }}; --oc-pull-opacity: {{ section.settings.quote_opacity | divided_by: 100.0 }}; --oc-accent: {{ section.settings.accent_color | default: '#A8553A' }};">

  {%- comment -%} HERO {%- endcomment -%}
  <section class="oc-hero">
    <div class="oc-hero__media">
      {%- assign hv_desktop = section.settings.hero_video | default: section.settings.hero_video_mobile -%}
      {%- assign hv_mobile = section.settings.hero_video_mobile | default: section.settings.hero_video -%}
      {%- if hv_desktop != blank and hv_desktop.id == hv_mobile.id -%}
        {%- comment -%} Only one video uploaded: use it on all screens {%- endcomment -%}
        {{ hv_desktop | video_tag:
          image_size: '2000x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'auto',
          class: 'oc-hero__video' }}
      {%- elsif hv_desktop != blank -%}
        {%- comment -%} Separate desktop + mobile videos; the script below plays only the one that fits the screen {%- endcomment -%}
        {{ hv_desktop | video_tag:
          image_size: '2000x',
          autoplay: false,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'none',
          class: 'oc-hero__video oc-hero__video--desktop' }}
        {{ hv_mobile | video_tag:
          image_size: '1080x',
          autoplay: false,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'none',
          class: 'oc-hero__video oc-hero__video--mobile' }}
        <script>
          (function () {
            var wrap = document.currentScript.parentElement;
            var d = wrap.querySelector('.oc-hero__video--desktop');
            var m = wrap.querySelector('.oc-hero__video--mobile');
            if (!d || !m) return;
            var mq = window.matchMedia('(max-width: 768px)');
            function pick() {
              var use = mq.matches ? m : d;
              var other = mq.matches ? d : m;
              other.pause();
              var p = use.play();
              if (p && p.catch) p.catch(function () {});
            }
            pick();
            if (mq.addEventListener) mq.addEventListener('change', pick);
            else if (mq.addListener) mq.addListener(pick);
          })();
        </script>
      {%- elsif section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag:
          widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high',
          alt: section.settings.hero_image.alt | default: section.settings.hero_heading | strip_newlines }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="oc-hero__overlay">
      {%- if section.settings.hero_eyebrow != blank -%}<p class="oc-hero__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.hero_heading != blank -%}<h1 class="oc-hero__heading">{{ section.settings.hero_heading | escape | newline_to_br }}</h1>{%- endif -%}
      {%- if section.settings.hero_sub != blank -%}<p class="oc-hero__sub">{{ section.settings.hero_sub | escape }}</p>{%- endif -%}
    </div>
  </section>

  {%- comment -%} INTRO {%- endcomment -%}
  {%- if section.settings.divider != blank -%}<div class="oc-divider" aria-hidden="true">{{ section.settings.divider | escape }}</div>{%- endif -%}
  {%- if section.settings.intro != blank -%}<div class="oc-intro">{{ section.settings.intro }}</div>{%- endif -%}

  {%- comment -%} IMAGE + TEXT ROWS {%- endcomment -%}
  {%- for block in rows -%}
    <section class="oc-editorial{% if block.settings.image_position == 'right' %} oc-editorial--right{% endif %}" {{ block.shopify_attributes }}>
      <div class="oc-editorial__image">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1400 | image_tag:
            widths: '450, 700, 900, 1200, 1400', sizes: '(max-width: 768px) 100vw, 50vw', loading: 'lazy',
            alt: block.settings.image.alt | default: block.settings.heading | strip_newlines }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="oc-editorial__text">
        {%- if block.settings.number != blank -%}<p class="oc-editorial__num">{{ block.settings.number | escape }}</p>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h2 class="oc-editorial__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
        {%- if block.settings.body != blank -%}<div class="oc-editorial__body">{{ block.settings.body }}</div>{%- endif -%}
      </div>
    </section>
  {%- endfor -%}

  {%- comment -%} OUR ETHOS {%- endcomment -%}
  {%- if ethos_items.size > 0 -%}
    <section class="oc-white oc-ethos">
      <div class="oc-wrap">
        <p class="oc-eyebrow">{{ section.settings.ethos_eyebrow | escape }}</p>
        <h2 class="oc-h2">{{ section.settings.ethos_heading | escape }} <em>{{ section.settings.ethos_heading_em | escape }}</em></h2>
        <div class="oc-ethos__grid">
          {%- for block in ethos_items -%}
            <div class="oc-card" {{ block.shopify_attributes }}>
              <svg class="oc-icon" viewBox="0 0 54 54" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'rings' -%}<circle cx="27" cy="27" r="6"/><circle cx="27" cy="27" r="14"/><circle cx="27" cy="27" r="22" stroke-dasharray="3 5"/>
                  {%- when 'cross' -%}<path d="M10 40 L44 14"/><path d="M10 14 L44 40" stroke-dasharray="2 5"/><circle cx="27" cy="27" r="4"/>
                  {%- when 'leaf' -%}<path d="M27 8 C 17 22, 17 34, 27 46 C 37 34, 37 22, 27 8Z"/><path d="M27 14 V46"/>
                  {%- when 'star' -%}<path d="M27 8 L32 22 L46 22 L35 31 L39 45 L27 36 L15 45 L19 31 L8 22 L22 22Z"/>
                {%- endcase -%}
              </svg>
              <h3 class="oc-card__title">{{ block.settings.title | escape }}</h3>
              <p class="oc-card__text">{{ block.settings.text | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} THE DETAILS YOU FEEL {%- endcomment -%}
  {%- if detail_items.size > 0 -%}
    <section class="oc-white oc-details">
      <div class="oc-wrap oc-wrap--wide">
        <p class="oc-eyebrow">{{ section.settings.details_eyebrow | escape }}</p>
        <h2 class="oc-h2">{{ section.settings.details_heading | escape }} <em>{{ section.settings.details_heading_em | escape }}</em></h2>
        <div class="oc-details__gallery">
          {%- for block in detail_items -%}
            <figure class="oc-frame" {{ block.shopify_attributes }}>
              {%- case block.settings.illustration -%}
                {%- when 'weave' -%}
                  <svg viewBox="0 0 300 340" role="img" aria-label="Woven fabric texture">
                    <defs><pattern id="oc-weave-{{ section.id }}-{{ block.id }}" width="20" height="20" patternUnits="userSpaceOnUse"><path class="oc-stroke" d="M0 5H20M0 15H20" stroke-width="3" opacity=".55"/><path class="oc-stroke" d="M5 0V20M15 0V20" stroke-width="3" opacity=".25"/></pattern></defs>
                    <rect width="300" height="340" fill="url(#oc-weave-{{ section.id }}-{{ block.id }})"/>
                  </svg>
                {%- when 'hem' -%}
                  <svg viewBox="0 0 300 340" role="img" aria-label="Hand-finished hem stitching">
                    <rect class="oc-fill" x="0" y="0" width="300" height="210" opacity=".2"/>
                    <rect class="oc-fill" x="0" y="210" width="300" height="130" opacity=".38"/>
                    <path class="oc-stroke" d="M0 210H300" stroke-width="2" fill="none"/>
                    <path d="M-4 232H304" class="oc-stitch"/>
                  </svg>
                {%- when 'button' -%}
                  <svg viewBox="0 0 300 340" role="img" aria-label="Sewn button">
                    <circle class="oc-fill" cx="150" cy="170" r="74" opacity=".22"/>
                    <circle class="oc-stroke" cx="150" cy="170" r="74" fill="none" stroke-width="3"/>
                    <circle class="oc-stroke" cx="150" cy="170" r="52" fill="none" stroke-width="1.5" opacity=".6"/>
                    <g class="oc-stroke" fill="#fff" stroke-width="2"><circle cx="132" cy="152" r="7"/><circle cx="168" cy="152" r="7"/><circle cx="132" cy="188" r="7"/><circle cx="168" cy="188" r="7"/></g>
                    <path class="oc-stroke" d="M132 152L168 188M168 152L132 188" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                  </svg>
              {%- endcase -%}
              <figcaption>{{ block.settings.caption | escape }}</figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} PULL QUOTE {%- endcomment -%}
  {%- if section.settings.quote != blank -%}
    <section class="oc-pull">
      <div class="oc-pull__media">
        {%- if section.settings.quote_image != blank -%}
          {{ section.settings.quote_image | image_url: width: 2000 | image_tag:
            widths: '800, 1200, 1600, 2000', sizes: '100vw', loading: 'lazy', alt: '' }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="oc-pull__content">
        <div class="oc-pull__mark" aria-hidden="true">"</div>
        <blockquote class="oc-pull__quote">{{ section.settings.quote | escape }}</blockquote>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} PROCESS {%- endcomment -%}
  {%- if steps.size > 0 -%}
    <section class="oc-process">
      {%- if section.settings.process_label != blank -%}<p class="oc-label">{{ section.settings.process_label | escape }}</p>{%- endif -%}
      <div class="oc-process__grid" style="--oc-cols: {{ steps.size | at_most: 4 }};">
        {%- for block in steps -%}
          <div class="oc-process__step" {{ block.shopify_attributes }}>
            <div class="oc-process__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
            {%- if block.settings.title != blank -%}<h3 class="oc-process__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="oc-process__body">{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} WHY IT MATTERS {%- endcomment -%}
  {%- if benefit_items.size > 0 -%}
    <section class="oc-white oc-why">
      <div class="oc-wrap">
        <p class="oc-eyebrow">{{ section.settings.why_eyebrow | escape }}</p>
        <h2 class="oc-h2">{{ section.settings.why_heading | escape }} <em>{{ section.settings.why_heading_em | escape }}</em></h2>
        <ul class="oc-benefits">
          {%- for block in benefit_items -%}
            <li {{ block.shopify_attributes }}>
              <span class="oc-benefits__tick" aria-hidden="true">✓</span>
              <div>
                <b>{{ block.settings.title | escape }}</b>
                <span>{{ block.settings.text | escape }}</span>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ONE PIECE, EVERY HOUR {%- endcomment -%}
  {%- if hour_items.size > 0 -%}
    {%- assign first_hour = hour_items | first -%}
    <section class="oc-white oc-hours" id="oc-hours-{{ section.id }}">
      <div class="oc-wrap oc-wrap--wide">
        <p class="oc-eyebrow">{{ section.settings.hours_eyebrow | escape }}</p>
        <h2 class="oc-h2">{{ section.settings.hours_heading | escape }} <em>{{ section.settings.hours_heading_em | escape }}</em></h2>
        {%- if section.settings.hours_sub != blank -%}<p class="oc-hours__sub">{{ section.settings.hours_sub | escape }}</p>{%- endif -%}

        <div class="oc-scene {{ first_hour.settings.time }}" data-scene>
          <div class="oc-sky morning{% if first_hour.settings.time == 'morning' %} on{% endif %}"></div>
          <div class="oc-sky midday{% if first_hour.settings.time == 'midday' %} on{% endif %}"></div>
          <div class="oc-sky evening{% if first_hour.settings.time == 'evening' %} on{% endif %}"></div>
          <div class="oc-sky night{% if first_hour.settings.time == 'night' %} on{% endif %}"></div>
          <div class="oc-orb"></div>
          <div class="oc-ground"></div>
          <svg viewBox="0 0 200 240" role="img" aria-label="The same garment shown through the day">
            <path class="g oc-fill" d="M70 30 Q100 50 130 30 L172 52 L156 88 L138 76 L138 200 L62 200 L62 76 L44 88 L28 52 Z" stroke-width="1.5" stroke-linejoin="round"/>
            <path class="g" d="M70 30 Q100 56 130 30" fill="none" stroke-width="1.5"/>
            <path d="M62 190H138" fill="none" stroke="#fff" stroke-width="1.8" stroke-dasharray="5 5"/>
          </svg>
        </div>

        <div class="oc-times" data-times>
          {%- for block in hour_items -%}
            <button type="button" class="oc-opt" data-t="{{ block.settings.time }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>
          {%- endfor -%}
        </div>

        <div class="oc-tinfo" data-info aria-live="polite">
          <h3>{{ first_hour.settings.title | escape }}</h3>
          <p><b>Wear it to:</b> {{ first_hour.settings.wear | escape }}</p>
          <p><b>Style it with:</b> {{ first_hour.settings.style | escape }}</p>
        </div>

        <script type="application/json" data-hours>
          {
            {%- for block in hour_items -%}
              {{ block.settings.time | json }}: [{{ block.settings.title | json }}, {{ block.settings.wear | json }}, {{ block.settings.style | json }}]{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          }
        </script>
        <script>
          (function () {
            var root = document.getElementById('oc-hours-{{ section.id }}');
            if (!root) return;
            var scene = root.querySelector('[data-scene]');
            var box = root.querySelector('[data-times]');
            var info = root.querySelector('[data-info]');
            var skies = scene.querySelectorAll('.oc-sky');
            var data = {};
            try { data = JSON.parse(root.querySelector('[data-hours]').textContent); } catch (e) {}
            function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
            box.addEventListener('click', function (e) {
              var b = e.target.closest('button');
              if (!b || !data[b.dataset.t]) return;
              var t = b.dataset.t;
              [].forEach.call(box.children, function (x) { x.setAttribute('aria-pressed', 'false'); });
              b.setAttribute('aria-pressed', 'true');
              scene.className = 'oc-scene ' + t;
              [].forEach.call(skies, function (s) { s.classList.toggle('on', s.classList.contains(t)); });
              var d = data[t];
              info.innerHTML = '<h3>' + esc(d[0]) + '</h3><p><b>Wear it to:</b> ' + esc(d[1]) + '</p><p><b>Style it with:</b> ' + esc(d[2]) + '</p>';
            });
          })();
        </script>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} SHOP {%- endcomment -%}
  {%- if section.settings.show_shop -%}
    {%- if section.settings.divider != blank -%}<div class="oc-divider" aria-hidden="true">{{ section.settings.divider | escape }}</div>{%- endif -%}
    <section class="oc-shop">
      {%- if section.settings.shop_label != blank -%}<p class="oc-label">{{ section.settings.shop_label | escape }}</p>{%- endif -%}
      <div class="oc-shop__grid">
        {%- for product in section.settings.products -%}
          <a class="oc-shop__card" href="{{ product.url }}">
            <div class="oc-shop__img">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 900 | image_tag:
                  widths: '300, 450, 600, 900', sizes: '(max-width: 768px) 50vw, 25vw', loading: 'lazy',
                  alt: product.featured_image.alt | default: product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <div class="oc-shop__info">
              <p class="oc-shop__name">{{ product.title | escape }}</p>
              <p class="oc-shop__price">
                {{ product.price | money }}
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                  {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                  <span class="oc-shop__badge">{{ pct }}% off</span>
                {%- endif -%}
              </p>
            </div>
          </a>
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="oc-shop__card">
              <div class="oc-shop__img">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}</div>
              <div class="oc-shop__info"><p class="oc-shop__name">Example product</p><p class="oc-shop__price">{{ 385000 | money }}</p></div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} TRUST STRIP {%- endcomment -%}
  {%- if trust_items.size > 0 -%}
    <div class="oc-trust">
      {%- for block in trust_items -%}
        <div class="oc-trust__item" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'returns' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            {%- when 'delivery' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {%- when 'shipping' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            {%- when 'secure' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {%- endcase -%}
          <span class="oc-trust__text">{{ block.settings.text | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  :root { --oc-bg:#FAF8F5; --oc-dark:#1A1A18; --oc-mid:#6B6560; --oc-line:rgba(26,26,24,0.1); --oc-serif:'Inter',system-ui,sans-serif; --oc-sans:'Inter',system-ui,sans-serif; }
  .oc, .oc *, .oc *::before, .oc *::after { box-sizing: border-box; }
  .oc { --oc-accent: #A8553A; background: var(--oc-bg); color: var(--oc-dark); font-family: var(--oc-sans); font-weight: 300; }
  .oc a { color: inherit; text-decoration: none; }
  .oc img, .oc svg.placeholder { display: block; width: 100%; }
  .oc h1, .oc h2, .oc h3, .oc p, .oc blockquote { margin: 0; }

  .oc-divider { text-align: center; padding: 56px 0 48px; color: var(--oc-mid); font-size: 18px; letter-spacing: 0.3em; }
  .oc-label { text-align: center; font-size: 11px; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; margin-bottom: 56px; }

  .oc-hero { position: relative; width: 100%; height: calc(var(--oc-hero-h, 92) * 1vh); min-height: 560px; overflow: hidden; background: #2a2520; }
  .oc-hero__media, .oc-hero__media img, .oc-hero__media svg, .oc-hero__media video { width: 100%; height: 100%; object-fit: cover; }
  .oc-hero__media video { display: block; }
  .oc-hero__media .oc-hero__video--mobile { display: none; }
  .oc-hero__media { opacity: var(--oc-hero-opacity, 0.72); }
  .oc-hero__overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding: 0 24px 80px; text-align: center; }
  .oc-hero__eyebrow { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.75); margin-bottom: 20px; }
  .oc-hero__heading { font-family: var(--oc-serif); font-size: clamp(42px, 7vw, 88px); font-weight: 300; font-style: italic; color: #fff; line-height: 1.1; max-width: 820px; }
  .oc-hero__sub { margin-top: 24px; font-size: 13px; letter-spacing: 0.06em; color: rgba(255,255,255,0.7); max-width: 400px; line-height: 1.8; }

  .oc-intro { max-width: 680px; margin: 0 auto; padding: 0 24px 80px; text-align: center; }
  .oc-intro p { font-family: var(--oc-serif); font-size: clamp(22px, 3vw, 32px); font-weight: 300; line-height: 1.65; }

  .oc-editorial { display: grid; grid-template-columns: 1fr 1fr; min-height: 600px; }
  .oc-editorial--right .oc-editorial__image { order: 2; }
  .oc-editorial__image { position: relative; overflow: hidden; background: #d4cfc9; min-height: 560px; }
  .oc-editorial__image img, .oc-editorial__image svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .oc-editorial__text { display: flex; flex-direction: column; justify-content: center; padding: clamp(40px, 6vw, 96px) clamp(32px, 5vw, 80px); background: var(--oc-bg); }
  .oc-editorial__num { font-family: var(--oc-serif); font-size: 13px; letter-spacing: 0.25em; color: var(--oc-mid); margin-bottom: 24px; }
  .oc-editorial__heading { font-family: var(--oc-serif); font-size: clamp(32px, 4vw, 52px); font-weight: 400; line-height: 1.2; margin-bottom: 20px; }
  .oc-editorial__body { font-size: 14px; line-height: 1.9; color: var(--oc-mid); max-width: 380px; }
  .oc-editorial__body p + p { margin-top: 1em; }

  .oc-pull { position: relative; width: 100%; min-height: 480px; overflow: hidden; background: var(--oc-dark); }
  .oc-pull__media, .oc-pull__media img, .oc-pull__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .oc-pull__media { opacity: var(--oc-pull-opacity, 0.3); }
  .oc-pull__content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 480px; padding: 80px 24px; text-align: center; }
  .oc-pull__mark { font-family: var(--oc-serif); font-size: 72px; color: rgba(255,255,255,0.2); line-height: 0.5; margin-bottom: 32px; }
  .oc-pull__quote { font-family: var(--oc-serif); font-size: clamp(28px, 4.5vw, 58px); font-style: italic; font-weight: 300; color: #fff; line-height: 1.3; max-width: 860px; }

  .oc-process { padding: 80px 0; }
  .oc-process__grid { display: grid; grid-template-columns: repeat(var(--oc-cols, 4), 1fr); }
  .oc-process__step { padding: 40px 36px; border-right: 1px solid var(--oc-line); }
  .oc-process__step:last-child { border-right: none; }
  .oc-process__num { font-family: var(--oc-serif); font-size: 48px; font-weight: 300; color: rgba(26,26,24,0.12); line-height: 1; margin-bottom: 16px; }
  .oc-process__title { font-family: var(--oc-serif); font-size: 22px; font-weight: 400; margin-bottom: 12px; }
  .oc-process__body { font-size: 13px; line-height: 1.85; color: var(--oc-mid); }

  .oc-shop { padding: 0 0 80px; }
  .oc-shop__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; background: rgba(26,26,24,0.06); }
  .oc-shop__card { display: block; background: var(--oc-bg); overflow: hidden; }
  .oc-shop__img { position: relative; aspect-ratio: 3/4; background: #e8e3dd; overflow: hidden; }
  .oc-shop__img img, .oc-shop__img svg { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .oc-shop__card:hover .oc-shop__img img { transform: scale(1.04); }
  .oc-shop__info { padding: 14px 16px 20px; }
  .oc-shop__name { font-size: 13px; font-weight: 400; margin-bottom: 6px; }
  .oc-shop__price { font-size: 13px; color: var(--oc-mid); }
  .oc-shop__price s { margin-left: 6px; font-size: 12px; }
  .oc-shop__badge { display: inline-block; margin-left: 6px; color: #c0392b; font-size: 11px; font-weight: 500; }

  .oc-trust { border-top: 1px solid var(--oc-line); border-bottom: 1px solid var(--oc-line); display: flex; justify-content: center; }
  .oc-trust__item { flex: 1; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 24px 20px; border-right: 1px solid var(--oc-line); }
  .oc-trust__item:last-child { border-right: none; }
  .oc-trust__item svg { width: 20px; height: 20px; stroke: var(--oc-dark); fill: none; stroke-width: 1.5; flex-shrink: 0; }
  .oc-trust__text { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; }

  /* ---------- Added sections: Ethos, Details, Why it matters, Hours (white background) ---------- */
  .oc-white { background: #fff; padding: 96px 24px; border-top: 1px solid var(--oc-line); }
  .oc-wrap { max-width: 760px; margin: 0 auto; }
  .oc-wrap--wide { max-width: 1040px; }
  .oc-eyebrow { font-size: 11px; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; color: var(--oc-accent); margin-bottom: 18px; }
  .oc-h2 { font-family: var(--oc-serif); font-size: clamp(30px, 5vw, 46px); font-weight: 400; line-height: 1.15; margin-bottom: 24px; }
  .oc-h2 em { font-style: italic; color: var(--oc-accent); }

  .oc-ethos__grid { display: grid; gap: 20px; margin-top: 36px; grid-template-columns: 1fr 1fr; }
  .oc-card { background: var(--oc-bg); padding: 30px 26px; border: 1px solid var(--oc-line); border-radius: 4px; }
  .oc-icon { width: 54px; height: 54px; margin-bottom: 14px; display: block; }
  .oc-icon * { stroke: var(--oc-accent); stroke-width: 1.6; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .oc-card__title { font-family: var(--oc-serif); font-weight: 500; font-size: 22px; margin-bottom: 8px; letter-spacing: -0.01em; }
  .oc-card__text { color: var(--oc-mid); font-size: 14px; line-height: 1.8; }

  .oc-details__gallery { display: grid; gap: 18px; margin-top: 32px; grid-template-columns: repeat(3, 1fr); }
  .oc-frame { background: var(--oc-bg); border: 1px solid var(--oc-line); border-radius: 4px; overflow: hidden; margin: 0; }
  .oc-frame svg { display: block; width: 100%; height: auto; }
  .oc-frame figcaption { padding: 14px 18px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--oc-mid); border-top: 1px solid var(--oc-line); background: #fff; }
  .oc-stroke { stroke: var(--oc-accent); }
  .oc-fill { fill: var(--oc-accent); }
  .oc-stitch { stroke: var(--oc-accent); stroke-width: 2; fill: none; stroke-dasharray: 7 9; stroke-linecap: round; animation: oc-run 5s linear infinite; }
  @keyframes oc-run { to { stroke-dashoffset: -64; } }
  @media (prefers-reduced-motion: reduce) { .oc-stitch { animation: none; } .oc-sky, .oc-orb { transition: none !important; } }

  .oc-benefits { list-style: none; padding: 0; margin: 34px 0 0; display: grid; gap: 16px; }
  .oc-benefits li { display: grid; grid-template-columns: 34px 1fr; gap: 12px; align-items: start; padding: 20px 22px; background: var(--oc-bg); border: 1px solid var(--oc-line); border-radius: 4px; }
  .oc-benefits__tick { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--oc-accent); color: var(--oc-accent); font-size: 15px; }
  .oc-benefits b { display: block; font-family: var(--oc-serif); font-weight: 500; font-size: 20px; line-height: 1.3; letter-spacing: -0.01em; margin-bottom: 4px; }
  .oc-benefits li > div > span { color: var(--oc-mid); font-size: 14px; line-height: 1.75; display: block; }

  .oc-hours__sub { color: var(--oc-mid); max-width: 560px; font-size: 14px; line-height: 1.8; }
  .oc-scene { position: relative; height: 320px; border-radius: 4px; overflow: hidden; border: 1px solid var(--oc-line); margin-top: 30px; --gs: #1A1A18; }
  .oc-scene.night { --gs: #f1e8da; }
  .oc-sky { position: absolute; inset: 0; opacity: 0; transition: opacity .9s ease; }
  .oc-sky.on { opacity: 1; }
  .oc-sky.morning { background: linear-gradient(#f6d9b8, #fbeee0); }
  .oc-sky.midday { background: linear-gradient(#a9d3ea, #eaf5fa); }
  .oc-sky.evening { background: linear-gradient(#e08a5b, #f3c48a 60%, #f6e1c3); }
  .oc-sky.night { background: linear-gradient(#1c2340, #3b3a63); }
  .oc-orb { position: absolute; width: 56px; height: 56px; border-radius: 50%; background: #fff4c9; box-shadow: 0 0 50px 16px rgba(255,236,170,.6); transition: left .9s ease, top .9s ease, background .9s ease, box-shadow .9s ease; left: 12%; top: 58%; }
  .oc-scene.midday .oc-orb { left: 46%; top: 6%; background: #fffbe0; }
  .oc-scene.evening .oc-orb { left: 80%; top: 52%; background: #ffb27a; box-shadow: 0 0 50px 16px rgba(255,160,100,.55); }
  .oc-scene.night .oc-orb { left: 78%; top: 10%; background: #f1e8da; box-shadow: 0 0 36px 8px rgba(241,232,218,.3); }
  .oc-ground { position: absolute; left: 0; right: 0; bottom: 0; height: 34px; background: rgba(0,0,0,.14); }
  .oc-scene svg { position: absolute; left: 50%; bottom: 22px; width: 170px; height: auto; transform: translateX(-50%); }
  .oc-scene svg path.g { stroke: var(--gs); transition: stroke .9s; }
  .oc-times { display: flex; gap: 10px; flex-wrap: wrap; margin: 22px 0 18px; }
  .oc-opt { font: inherit; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; padding: 12px 20px; border: 1px solid var(--oc-line); background: #fff; color: var(--oc-dark); border-radius: 2px; cursor: pointer; }
  .oc-opt[aria-pressed="true"] { outline: 2px solid var(--oc-accent); outline-offset: 2px; }
  .oc-tinfo { background: var(--oc-bg); border: 1px solid var(--oc-line); border-radius: 4px; padding: 24px 24px 20px; }
  .oc-tinfo h3 { font-family: var(--oc-serif); font-weight: 500; font-size: 24px; letter-spacing: -0.01em; margin-bottom: 8px; }
  .oc-tinfo p { margin: 0 0 8px; color: var(--oc-mid); font-size: 14px; line-height: 1.75; }
  .oc-tinfo p b { color: var(--oc-dark); font-weight: 500; }

  /* Inter is wider than the previous serif, so tighten large display text */
  .oc-hero__heading, .oc-editorial__heading, .oc-pull__quote, .oc-intro p, .oc-process__title, .oc-h2 { letter-spacing: -0.02em; }

  @media (max-width: 768px) {
    .oc-hero { height: 85vh; }
    .oc-hero__media .oc-hero__video--desktop { display: none; }
    .oc-hero__media .oc-hero__video--mobile { display: block; }
    .oc-editorial { grid-template-columns: 1fr; }
    .oc-editorial--right .oc-editorial__image { order: 0; }
    .oc-editorial__image { min-height: 360px; }
    .oc-process__grid { grid-template-columns: 1fr 1fr; }
    .oc-process__step:nth-child(2n) { border-right: none; }
    .oc-process__step:nth-child(n+3) { border-top: 1px solid var(--oc-line); }
    .oc-shop__grid { grid-template-columns: 1fr 1fr; }
    .oc-trust { flex-wrap: wrap; }
    .oc-trust__item { flex: 1 1 50%; border-right: none; border-bottom: 1px solid var(--oc-line); }
    .oc-trust__item:nth-child(odd) { border-right: 1px solid var(--oc-line); }
    .oc-trust__item:last-child { border-bottom: none; }
    .oc-white { padding: 64px 20px; }
    .oc-ethos__grid { grid-template-columns: 1fr; }
    .oc-details__gallery { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ourcrafttest",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "video", "id": "hero_video", "label": "Background video (desktop)", "info": "Landscape .mp4, ideally 1920×1080 (16:9). Shopify-hosted (up to 1 GB / 10 min). Plays muted and looping. Smaller files load faster." },
    { "type": "video", "id": "hero_video_mobile", "label": "Background video (mobile)", "info": "Portrait .mp4, ideally 1080×1920 (9:16), shown on screens 768px and narrower. Smaller files load faster. If empty, the desktop video is used on mobile too." },
    { "type": "image_picker", "id": "hero_image", "label": "Background image (fallback)" },
    { "type": "range", "id": "hero_opacity", "label": "Media opacity", "min": 20, "max": 100, "step": 4, "unit": "%", "default": 72 },
    { "type": "range", "id": "hero_height", "label": "Height", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 90 },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Our Craft" },
    { "type": "textarea", "id": "hero_heading", "label": "Heading", "info": "Line breaks are preserved.", "default": "Four hours of someone's day,\nin every shirt." },
    { "type": "textarea", "id": "hero_sub", "label": "Subheading", "default": "Every piece we make carries the hands, the time, and the care of the craftswomen behind it." },

    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "divider", "label": "Divider symbol", "info": "Leave blank to hide. Also used above the shop grid.", "default": "❋" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>We don't make clothes on a conveyor belt. Every shirt, every co-ord, every kurta begins with a woman who knows her craft — and ends with a piece that shows it.</p>" },

    { "type": "header", "content": "Accent colour (new sections)" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#A8553A" },

    { "type": "header", "content": "Our ethos" },
    { "type": "text", "id": "ethos_eyebrow", "label": "Eyebrow", "default": "Our Ethos" },
    { "type": "text", "id": "ethos_heading", "label": "Heading", "default": "Four quiet" },
    { "type": "text", "id": "ethos_heading_em", "label": "Heading (accent word)", "default": "promises" },

    { "type": "header", "content": "The details you feel" },
    { "type": "text", "id": "details_eyebrow", "label": "Eyebrow", "default": "Up Close" },
    { "type": "text", "id": "details_heading", "label": "Heading", "default": "The" },
    { "type": "text", "id": "details_heading_em", "label": "Heading (accent word)", "default": "details you feel" },

    { "type": "header", "content": "Pull quote" },
    { "type": "image_picker", "id": "quote_image", "label": "Background image" },
    { "type": "range", "id": "quote_opacity", "label": "Image opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
    { "type": "textarea", "id": "quote", "label": "Quote", "info": "Leave blank to hide the quote section.", "default": "When something is made well, you don't have to explain it. You just wear it." },

    { "type": "header", "content": "Process" },
    { "type": "text", "id": "process_label", "label": "Label", "default": "How we make it" },

    { "type": "header", "content": "Why it matters" },
    { "type": "text", "id": "why_eyebrow", "label": "Eyebrow", "default": "Why It Matters" },
    { "type": "text", "id": "why_heading", "label": "Heading", "default": "What this means" },
    { "type": "text", "id": "why_heading_em", "label": "Heading (accent word)", "default": "for you" },

    { "type": "header", "content": "One piece, every hour" },
    { "type": "text", "id": "hours_eyebrow", "label": "Eyebrow", "default": "Versatility" },
    { "type": "text", "id": "hours_heading", "label": "Heading", "default": "One piece," },
    { "type": "text", "id": "hours_heading_em", "label": "Heading (accent word)", "default": "every hour" },
    { "type": "textarea", "id": "hours_sub", "label": "Subtext", "default": "The same garment, from the first coffee to the last light. Choose a time of day and see how it moves with you." },

    { "type": "header", "content": "Shop" },
    { "type": "checkbox", "id": "show_shop", "label": "Show product grid", "default": true },
    { "type": "text", "id": "shop_label", "label": "Label", "default": "Shop the craft" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Image + text row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "image_position", "label": "Image position", "default": "left",
          "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
        { "type": "text", "id": "number", "label": "Label", "default": "01 — The Stitch" },
        { "type": "textarea", "id": "heading", "label": "Heading", "info": "Line breaks are preserved.", "default": "Stitched like it\nneeds to last." },
        { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Machine-made clothes are sewn fast. Ours are sewn right.</p>" }
      ]
    },
    {
      "type": "step",
      "name": "Process step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this step." }
      ]
    },
    {
      "type": "ethos",
      "name": "Ethos card",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "rings",
          "options": [
            { "value": "rings", "label": "Rings" },
            { "value": "cross", "label": "Crossed lines" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Small batch" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this promise." }
      ]
    },
    {
      "type": "detail",
      "name": "Detail illustration",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "illustration", "label": "Illustration", "default": "weave",
          "options": [
            { "value": "weave", "label": "Woven fabric" },
            { "value": "hem", "label": "Hand-finished hem" },
            { "value": "button", "label": "Sewn button" }
          ] },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Light, breathable weave" }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this benefit." }
      ]
    },
    {
      "type": "hour",
      "name": "Time of day",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "time", "label": "Scene", "default": "morning",
          "options": [
            { "value": "morning", "label": "Morning" },
            { "value": "midday", "label": "Midday" },
            { "value": "evening", "label": "Evening" },
            { "value": "night", "label": "Night" }
          ] },
        { "type": "text", "id": "label", "label": "Button label", "default": "Morning" },
        { "type": "text", "id": "title", "label": "Title", "default": "A slow, easy start" },
        { "type": "text", "id": "wear", "label": "Wear it to", "default": "morning coffee, the commute, an early meeting." },
        { "type": "text", "id": "style", "label": "Style it with", "default": "flats and a simple canvas bag." }
      ]
    },
    {
      "type": "trust",
      "name": "Trust item",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "returns",
          "options": [
            { "value": "returns", "label": "Home (returns)" },
            { "value": "delivery", "label": "Truck (delivery)" },
            { "value": "shipping", "label": "Arrow (shipping)" },
            { "value": "secure", "label": "Shield (secure)" }
          ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Easy Returns" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ourcrafttest",
      "blocks": [
        { "type": "row", "settings": { "image_position": "left", "number": "01 — The Stitch", "heading": "Stitched like it\nneeds to last.", "body": "<p>Machine-made clothes are sewn fast. Ours are sewn right. Every seam is finished by hand, every stitch checked before a piece leaves the workshop. You'll feel the difference the first time you wear it — and still feel it three years later.</p>" } },
        { "type": "row", "settings": { "image_position": "right", "number": "02 — The Fabric", "heading": "Handloom cotton.\nNothing else.", "body": "<p>We source directly from small handloom clusters — fabrics that breathe, that soften with every wash, that hold their colour without compromise. The kind of cloth that mass production simply cannot replicate.</p>" } },
        { "type": "row", "settings": { "image_position": "left", "number": "03 — The Batch", "heading": "Small batches.\nOn purpose.", "body": "<p>We make limited runs — not because we can't scale, but because we won't. Smaller batches mean more attention per piece, less waste, and something that not everyone else will be wearing.</p>" } },

        { "type": "ethos", "settings": { "icon": "rings", "title": "Small batch", "text": "We make in limited numbers, never in thousands. Fewer pieces means more attention in each one, and nothing made to sit unloved on a shelf." } },
        { "type": "ethos", "settings": { "icon": "cross", "title": "Made around you", "text": "Length, sleeve, neckline, fit. Your garment can be adjusted to your body and your taste, because you are not a standard size." } },
        { "type": "ethos", "settings": { "icon": "leaf", "title": "Breathable cloth", "text": "Light, soft, easy fabrics chosen to move with you through long days and warm evenings, comfort that you forget you are wearing." } },
        { "type": "ethos", "settings": { "icon": "star", "title": "Details that count", "text": "A hand-finished hem, a considered button, a seam that lies flat. The small things are the ones you notice and keep noticing." } },

        { "type": "detail", "settings": { "illustration": "weave", "caption": "Light, breathable weave" } },
        { "type": "detail", "settings": { "illustration": "hem", "caption": "Hand-finished hem" } },
        { "type": "detail", "settings": { "illustration": "button", "caption": "A considered button" } },

        { "type": "step", "settings": { "title": "We source the fabric", "text": "Every piece starts with handloom cotton sourced directly from artisan clusters. We feel, wash, and test before a single yard is cut." } },
        { "type": "step", "settings": { "title": "We cut with intention", "text": "Cutting is done by hand, piece by piece — no bulk cutting, no waste. Each pattern is measured for the size it will become." } },
        { "type": "step", "settings": { "title": "We stitch with care", "text": "Our craftswomen stitch at their own pace — not against a clock. Every seam is flat-finished, every hem hand-turned before the next step begins." } },
        { "type": "step", "settings": { "title": "We check before we ship", "text": "A final quality check happens on every single piece — stitching, sizing, finish, and feel — before it's folded and packed for you." } },

        { "type": "benefit", "settings": { "title": "A fit that is truly yours", "text": "Made to your measurements and preferences, so you stop settling for “almost right”." } },
        { "type": "benefit", "settings": { "title": "Comfort from the first wear", "text": "Light, breathable fabrics that stay easy through long days and warm weather." } },
        { "type": "benefit", "settings": { "title": "Pieces that last", "text": "Careful hand finishing means seams and details that hold up wear after wear." } },
        { "type": "benefit", "settings": { "title": "Never one of a crowd", "text": "Small batches and personal choices mean you are unlikely to meet your outfit on someone else." } },
        { "type": "benefit", "settings": { "title": "A maker you can talk to", "text": "Tell us what you need directly. A real person listens and makes it." } },

        { "type": "hour", "settings": { "time": "morning", "label": "Morning", "title": "A slow, easy start", "wear": "morning coffee, the commute, an early meeting.", "style": "flats and a simple canvas bag." } },
        { "type": "hour", "settings": { "time": "midday", "label": "Midday", "title": "Easy, bright hours", "wear": "long lunches, errands, a busy workday.", "style": "rolled sleeves, a light belt and sunglasses." } },
        { "type": "hour", "settings": { "time": "evening", "label": "Evening", "title": "Golden hour, dressed up", "wear": "dinner with family, a gathering, an evening out.", "style": "statement earrings and a soft shawl." } },
        { "type": "hour", "settings": { "time": "night", "label": "Night", "title": "A calm, comfortable close", "wear": "a quiet night in, a late stroll, time with loved ones.", "style": "nothing extra. The cloth stays soft and light." } },

        { "type": "trust", "settings": { "icon": "returns", "text": "Easy Returns" } },
        { "type": "trust", "settings": { "icon": "delivery", "text": "Cash on Delivery" } },
        { "type": "trust", "settings": { "icon": "shipping", "text": "Free Shipping" } },
        { "type": "trust", "settings": { "icon": "secure", "text": "Secure Checkout" } }
      ]
    }
  ]
}
{% endschema %}
