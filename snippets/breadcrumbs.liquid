<nav class="breadcrumbs page-width-normal" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a href="{{ routes.root_url }}">Home</a>
    </li>

    {% if template.name == 'collection' and collection != blank %}
      <li class="breadcrumbs__item" aria-current="page">
        {{ collection.title | escape }}
      </li>
    {% elsif template.name == 'product' and product != blank %}
      {% if collection != blank %}
        <li class="breadcrumbs__item">
          <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
        </li>
      {% endif %}
      <li class="breadcrumbs__item" aria-current="page">
        {{ product.title | escape }}
      </li>
    {% endif %}
  </ol>
</nav>

{% if template.name == 'product' or template.name == 'collection' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }{% if template.name == 'collection' and collection != blank %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        }{% elsif template.name == 'product' and product != blank and collection != blank %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ shop.url | append: product.url | json }}
        }{% elsif template.name == 'product' and product != blank %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": {{ shop.url | append: product.url | json }}
        }{% endif %}
      ]
    }
  </script>
{% endif %}
