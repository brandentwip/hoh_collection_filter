{%- comment -%}
PERF FIX: MutationObserver removed.
The original code observed the entire <html> element with { attributes: true, childList: true, subtree: true }.
This fires a callback on EVERY DOM mutation site-wide (every add-to-cart, every dropdown, every animation).
The callback body only did console.log() — it had no functional effect.
This was the single largest contributor to poor INP on this store.
If cart button visibility logic is needed in future, use a targeted selector and disconnect after first match.
{%- endcomment -%}

<script>
  const getCountryData = async(element) =>{
  const getCountry = await fetch("/browsing_context_suggestions.json");
  const response = await getCountry.json();
  const res = response?.detected_values?.country_name;
    let css= ""
  if(res === 'India'){
     css = `
  .shopifycheckoutbtn{display:none !important;}
  `
  }else{
      css = `
  .gokwik-checkout{display:none !important;}
  #gokwik-buy-now{display:none !important;}
  `
  }
    const styleElement = document.createElement("style");
styleElement.textContent = css;
    document.head.appendChild(styleElement);
}
  document.addEventListener("DOMContentLoaded", getCountryData);
</script>


