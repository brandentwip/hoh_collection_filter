<script
  src="{{ 'gift-card-recipient-form.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<quick-add-dialog id="quick-add-dialog">
  <dialog
    class="quick-add-modal dialog-modal color-{{ settings.quick_add_modal_color_scheme | default: settings.popover_color_scheme }}"
    ref="quickAddDialog"
    scroll-lock
  >
    <button
      ref="closeButton"
      type="button"
      class="button button-unstyled close-button quick-add-modal__close"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
      style="position: absolute; top: var(--margin-2xs); right: var(--margin-2xs); z-index: 2147483647; pointer-events: auto;"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <div
      id="quick-add-modal-content"
      class="quick-add-modal__content"
      aria-live="polite"
    ></div>
  </dialog>
</quick-add-dialog>

{% render 'quick-add-modal-styles' %}
{% render 'product-media-gallery-content-styles' %}
