{%- doc -%}
  Renders the product quick-view button.

  @param {object} product - The product object
  @param {string} [color_scheme] - The color scheme to use
{%- enddoc -%}

{% liquid
  assign color_scheme = color_scheme | default: settings.quick_add_color_scheme
%}

<quick-add-component
  class="quick-add color-{{ color_scheme }}"
  ref="quickAdd"
  data-product-title="{{ product.title | escape }}"
>
  <button
    class="button quick-add__button quick-add__button--choose"
    type="button"
    aria-label="{{ 'content.view_more_details' | t }} {{ product.title | escape }}"
    aria-haspopup="dialog"
    aria-controls="quick-add-dialog"
    on:click="quick-add-component/handleClick"
  >
    <span class="add-to-cart-text">
      <span aria-hidden="true" class="svg-wrapper add-to-cart-icon">
        {{- 'icon-search.svg' | inline_asset_content -}}
      </span>
      <span class="add-to-cart-text__content is-visually-hidden-mobile">
        <span>
          <span>{{ 'content.view_more_details' | t }}</span>
        </span>
      </span>
    </span>
  </button>
</quick-add-component>

{% render 'quick-add-styles' %}
