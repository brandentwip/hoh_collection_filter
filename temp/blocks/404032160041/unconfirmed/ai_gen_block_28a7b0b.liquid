{% doc %}
  @prompt
    create a premium discount banner flat25%off use code HOHSAVE25, full width, must be match full page width, revert changes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-discount-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-discount-banner__container-{{ ai_gen_id }} {
    background: {{ block.settings.background_gradient }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: center;
    position: relative;
    overflow: hidden;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-discount-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-discount-banner__badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .ai-discount-banner__message-{{ ai_gen_id }} {
    color: {{ block.settings.message_color }};
    font-size: {{ block.settings.message_font_size }}px;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
  }

  .ai-discount-banner__code-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-discount-banner__code-label-{{ ai_gen_id }} {
    color: {{ block.settings.code_label_color }};
    font-size: {{ block.settings.code_font_size }}px;
    font-weight: 500;
  }

  .ai-discount-banner__code-{{ ai_gen_id }} {
    background-color: {{ block.settings.code_background }};
    color: {{ block.settings.code_text_color }};
    padding: {{ block.settings.code_padding_vertical }}px {{ block.settings.code_padding_horizontal }}px;
    border: {{ block.settings.code_border_width }}px dashed {{ block.settings.code_border_color }};
    border-radius: {{ block.settings.code_border_radius }}px;
    font-size: {{ block.settings.code_font_size }}px;
    font-weight: 700;
    letter-spacing: 2px;
    font-family: monospace;
  }

  .ai-discount-banner__cta-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.cta_background }};
    color: {{ block.settings.cta_text_color }};
    padding: {{ block.settings.cta_padding_vertical }}px {{ block.settings.cta_padding_horizontal }}px;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-discount-banner__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_background }};
    color: {{ block.settings.cta_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-discount-banner__container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-discount-banner__badge-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_font_size | times: 0.9 }}px;
    }

    .ai-discount-banner__message-{{ ai_gen_id }} {
      font-size: {{ block.settings.message_font_size | times: 0.9 }}px;
    }

    .ai-discount-banner__code-label-{{ ai_gen_id }},
    .ai-discount-banner__code-{{ ai_gen_id }} {
      font-size: {{ block.settings.code_font_size | times: 0.9 }}px;
    }

    .ai-discount-banner__cta-{{ ai_gen_id }} {
      font-size: {{ block.settings.cta_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-discount-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-discount-banner__container-{{ ai_gen_id }}">
    <div class="ai-discount-banner__content-{{ ai_gen_id }}">
      {% if block.settings.show_badge %}
        <div class="ai-discount-banner__badge-{{ ai_gen_id }}">
          {{ block.settings.badge_text }}
        </div>
      {% endif %}

      {% if block.settings.message != blank %}
        <p class="ai-discount-banner__message-{{ ai_gen_id }}">
          {{ block.settings.message }}
        </p>
      {% endif %}

      {% if block.settings.show_code and block.settings.discount_code != blank %}
        <div class="ai-discount-banner__code-wrapper-{{ ai_gen_id }}">
          <span class="ai-discount-banner__code-label-{{ ai_gen_id }}">
            {{ block.settings.code_label }}
          </span>
          <span class="ai-discount-banner__code-{{ ai_gen_id }}">
            {{ block.settings.discount_code }}
          </span>
        </div>
      {% endif %}

      {% if block.settings.show_cta and block.settings.cta_link != blank %}
        <a href="{{ block.settings.cta_link }}" class="ai-discount-banner__cta-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

