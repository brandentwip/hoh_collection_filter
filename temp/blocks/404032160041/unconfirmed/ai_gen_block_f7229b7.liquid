{% doc %}
  @prompt
    CREATE A DISCOUNT BADGE FLAT25% OFF USE CODE HOHSAVE25, MAKE IT FULL WIDTH 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-discount-badge-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-discount-badge-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    gap: {{ block.settings.text_gap }}px;
    text-align: center;
    width: 100%;
    {% if block.settings.border_width > 0 %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-discount-badge-main-text-{{ ai_gen_id }} {
    color: {{ block.settings.main_text_color }};
    font-size: {{ block.settings.main_text_size }}px;
    font-weight: {{ block.settings.main_text_weight }};
    line-height: 1.2;
    margin: 0;
    text-transform: {{ block.settings.main_text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  .ai-discount-badge-code-text-{{ ai_gen_id }} {
    color: {{ block.settings.code_text_color }};
    font-size: {{ block.settings.code_text_size }}px;
    font-weight: {{ block.settings.code_text_weight }};
    line-height: 1.2;
    margin: 0;
    text-transform: {{ block.settings.code_text_transform }};
  }

  @media screen and (max-width: 749px) {
    .ai-discount-badge-main-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_text_size | times: 0.8 }}px;
    }

    .ai-discount-badge-code-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.code_text_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-discount-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-discount-badge-wrapper-{{ ai_gen_id }}">
    {% if block.settings.main_text != blank %}
      <div class="ai-discount-badge-main-text-{{ ai_gen_id }}">
        {{ block.settings.main_text }}
      </div>
    {% endif %}
    {% if block.settings.code_text != blank %}
      <div class="ai-discount-badge-code-text-{{ ai_gen_id }}">
        {{ block.settings.code_text }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Discount badge",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "main_text",
      "label": "Main text",
      "default": "FLAT25% OFF"
    },
    {
      "type": "text",
      "id": "code_text",
      "label": "Code text",
      "default": "USE CODE HOHSAVE25"
    },
    {
      "type": "header",
      "content": "Main text style"
    },
    {
      "type": "range",
      "id": "main_text_size",
      "label": "Size",
      "min": 10,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "main_text_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "main_text_transform",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "color",
      "id": "main_text_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Code text style"
    },
    {
      "type": "range",
      "id": "code_text_size",
      "label": "Size",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "code_text_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "code_text_transform",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "color",
      "id": "code_text_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Badge style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#c15045"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Text spacing",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Discount badge"
    }
  ]
}
{% endschema %}