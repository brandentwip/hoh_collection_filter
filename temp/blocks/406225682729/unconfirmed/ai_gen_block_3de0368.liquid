{% doc %}
  @prompt
    a hero banner section with both option to upload desktop as well as mobile size banners and it should be a slideshow of 2 banners
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-slideshow-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-hero-slideshow__viewport-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
  }

  .ai-hero-slideshow__slides-{{ ai_gen_id }} {
    display: flex;
    width: 200%;
    height: 100%;
    transition: transform 0.6s ease-in-out;
  }

  .ai-hero-slideshow__slide-{{ ai_gen_id }} {
    position: relative;
    width: 50%;
    height: 100%;
    flex-shrink: 0;
  }

  .ai-hero-slideshow__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-hero-slideshow__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-slideshow__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-slideshow__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-slideshow__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: {{ block.settings.text_color }};
    width: 90%;
    max-width: 800px;
    z-index: 2;
  }

  .ai-hero-slideshow__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-slideshow__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-slideshow__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: background-color 0.3s ease;
  }

  .ai-hero-slideshow__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-hero-slideshow__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-hero-slideshow__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 3;
  }

  .ai-hero-slideshow__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.3s ease;
    border: none;
    padding: 0;
  }

  .ai-hero-slideshow__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-hero-slideshow__arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 0 20px;
    transform: translateY(-50%);
    z-index: 3;
    pointer-events: none;
  }

  .ai-hero-slideshow__arrow-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    pointer-events: all;
  }

  .ai-hero-slideshow__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
  }

  .ai-hero-slideshow__arrow-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slideshow__viewport-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-hero-slideshow__image-{{ ai_gen_id }}.desktop {
      display: none;
    }

    .ai-hero-slideshow__image-{{ ai_gen_id }}.mobile {
      display: block;
    }

    .ai-hero-slideshow__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-hero-slideshow__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.8 }}px;
    }

    .ai-hero-slideshow__arrow-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .ai-hero-slideshow__arrow-{{ ai_gen_id }} svg {
      width: 18px;
      height: 18px;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-hero-slideshow__image-{{ ai_gen_id }}.mobile {
      display: none;
    }

    .ai-hero-slideshow__image-{{ ai_gen_id }}.desktop {
      display: block;
    }
  }
{% endstyle %}

<hero-slideshow-{{ ai_gen_id }}
  class="ai-hero-slideshow-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-slideshow__viewport-{{ ai_gen_id }}">
    <div class="ai-hero-slideshow__slides-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% liquid
          assign slide_desktop_image_key = 'slide_' | append: i | append: '_desktop_image'
          assign slide_mobile_image_key = 'slide_' | append: i | append: '_mobile_image'
          assign slide_heading_key = 'slide_' | append: i | append: '_heading'
          assign slide_subtext_key = 'slide_' | append: i | append: '_subtext'
          assign slide_button_text_key = 'slide_' | append: i | append: '_button_text'
          assign slide_button_link_key = 'slide_' | append: i | append: '_button_link'

          assign desktop_image = block.settings[slide_desktop_image_key]
          assign mobile_image = block.settings[slide_mobile_image_key]
          assign heading = block.settings[slide_heading_key]
          assign subtext = block.settings[slide_subtext_key]
          assign button_text = block.settings[slide_button_text_key]
          assign button_link = block.settings[slide_button_link_key]
        %}

        <div class="ai-hero-slideshow__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
          {% if desktop_image or mobile_image %}
            {% if desktop_image %}
              <img
                src="{{ desktop_image | image_url: width: 2000 }}"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                class="ai-hero-slideshow__image-{{ ai_gen_id }} desktop"
              >
            {% endif %}
            {% if mobile_image %}
              <img
                src="{{ mobile_image | image_url: width: 1000 }}"
                alt="{{ mobile_image.alt | escape }}"
                loading="lazy"
                width="{{ mobile_image.width }}"
                height="{{ mobile_image.height }}"
                class="ai-hero-slideshow__image-{{ ai_gen_id }} mobile"
              >
            {% elsif desktop_image %}
              <img
                src="{{ desktop_image | image_url: width: 1000 }}"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                class="ai-hero-slideshow__image-{{ ai_gen_id }} mobile"
              >
            {% endif %}
          {% else %}
            <div class="ai-hero-slideshow__placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
              <div class="ai-hero-slideshow__empty-state-{{ ai_gen_id }}">
                Add images for slide {{ i }}
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_overlay %}
            <div class="ai-hero-slideshow__overlay-{{ ai_gen_id }}"></div>
          {% endif %}

          {% if heading != blank or subtext != blank or button_text != blank %}
            <div class="ai-hero-slideshow__content-{{ ai_gen_id }}">
              {% if heading != blank %}
                <h2 class="ai-hero-slideshow__heading-{{ ai_gen_id }}">{{ heading }}</h2>
              {% endif %}
              {% if subtext != blank %}
                <div class="ai-hero-slideshow__subtext-{{ ai_gen_id }}">{{ subtext }}</div>
              {% endif %}
              {% if button_text != blank %}
                <a
                  href="{{ button_link | default: '#' }}"
                  class="ai-hero-slideshow__button-{{ ai_gen_id }}"
                >
                  {{ button_text }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  {% if block.settings.show_arrows %}
    <div class="ai-hero-slideshow__arrows-{{ ai_gen_id }}">
      <button
        class="ai-hero-slideshow__arrow-{{ ai_gen_id }} ai-hero-slideshow__arrow-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-hero-slideshow__arrow-{{ ai_gen_id }} ai-hero-slideshow__arrow-next-{{ ai_gen_id }}"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {% endif %}

  {% if block.settings.show_dots %}
    <div class="ai-hero-slideshow__controls-{{ ai_gen_id }}">
      <button class="ai-hero-slideshow__dot-{{ ai_gen_id }} active" data-slide="1" aria-label="Go to slide 1"></button>
      <button class="ai-hero-slideshow__dot-{{ ai_gen_id }}" data-slide="2" aria-label="Go to slide 2"></button>
    </div>
  {% endif %}
</hero-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroSlideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slidesContainer = this.querySelector('.ai-hero-slideshow__slides-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-hero-slideshow__dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-hero-slideshow__arrow-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-hero-slideshow__arrow-next-{{ ai_gen_id }}');
        
        this.setupEventListeners();
        
        if (this.dataset.autoplay === 'true') {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const slideNumber = parseInt(dot.dataset.slide);
            this.goToSlide(slideNumber);
            this.resetAutoplay();
          });
        });

        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.previousSlide();
            this.resetAutoplay();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.nextSlide();
            this.resetAutoplay();
          });
        }
      }

      goToSlide(slideNumber) {
        this.currentSlide = slideNumber;
        const offset = (slideNumber - 1) * -50;
        this.slidesContainer.style.transform = `translateX(${offset}%)`;
        
        this.dots.forEach((dot) => {
          dot.classList.remove('active');
          if (parseInt(dot.dataset.slide) === slideNumber) {
            dot.classList.add('active');
          }
        });
      }

      nextSlide() {
        const next = this.currentSlide === 2 ? 1 : this.currentSlide + 1;
        this.goToSlide(next);
      }

      previousSlide() {
        const prev = this.currentSlide === 1 ? 2 : this.currentSlide - 1;
        this.goToSlide(prev);
      }

      startAutoplay() {
        const speed = parseInt(this.dataset.autoplaySpeed) * 1000;
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, speed);
      }

      resetAutoplay() {
        if (this.dataset.autoplay === 'true') {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('hero-slideshow-{{ ai_gen_id }}', HeroSlideshow{{ ai_gen_id }});
  })();
</script>

