{% doc %}
  @prompt
    ADD A BANNER OR HIGHLIGHT - SAYING NO RETURN / EXCHANGE / CUSTOMISATION APPLY ON CLEARANCE										
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-clearance-notice-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 16px 20px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
    text-align: center;
    font-family: inherit;
  }

  .ai-clearance-notice-{{ ai_gen_id }}__title {
    margin: 0 0 5px;
    color: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ai-clearance-notice-{{ ai_gen_id }}__message {
    margin: 0;
    color: inherit;
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-clearance-notice-{{ ai_gen_id }} {
      padding: 14px 16px;
    }
  }
{% endstyle %}

<div class="ai-clearance-notice-{{ ai_gen_id }}" role="note" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
  <p class="ai-clearance-notice-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</p>
  <p class="ai-clearance-notice-{{ ai_gen_id }}__message">{{ block.settings.message | escape }}</p>
</div>

{% schema %}
{
  "name": "Clearance notice",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clearance sale notice"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Notice",
      "default": "No returns, exchanges, or customisation apply to clearance items."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F2E8D8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#241C14"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#C8B99F"
    }
  ],
  "presets": [
    {
      "name": "Clearance notice"
    }
  ],
  "tag": null,
  "class": "clearance-notice-block"
}
{% endschema %}