   }\n\n    \/* ── DEMO CONTEXT STRIP ── *\/\n    .demo-bar {\n      background: var(--black);\n      color: var(--white);\n      font-size: 11px;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      text-align: center;\n      padding: 10px;\n      opacity: 0.5;\n    }\n\n    \/* ══════════════════════════════════════\n       A+ SECTION\n    ══════════════════════════════════════ *\/\n    .ap {\n      max-width: 1140px;\n      margin: 0 auto;\n      padding: 80px 24px 60px;\n    }\n\n    \/* ── HERO HEADER ── *\/\n    .ap-header {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 0;\n      border-top: 1px solid var(--black);\n      padding-top: 48px;\n      margin-bottom: 64px;\n      align-items: end;\n    }\n\n    .ap-eyebrow {\n      font-size: 10px;\n      letter-spacing: 0.25em;\n      text-transform: uppercase;\n      color: var(--gray-600);\n      margin-bottom: 16px;\n    }\n\n    .ap-hero-title {\n      font-size: clamp(42px, 6vw, 72px);\n      font-weight: 300;\n      line-height: 1.0;\n      letter-spacing: -0.02em;\n      color: var(--black);\n    }\n\n    .ap-hero-title em {\n      font-style: italic;\n    }\n\n    .ap-header-right {\n      padding-left: 40px;\n      border-left: 1px solid var(--gray-200);\n    }\n\n    .ap-header-right p {\n      font-size: 14px;\n      font-weight: 300;\n      line-height: 1.8;\n      color: var(--gray-600);\n      margin-bottom: 20px;\n      max-width: 340px;\n    }\n\n    .ap-tag {\n      display: inline-block;\n      font-size: 10px;\n      letter-spacing: 0.15em;\n      text-transform: uppercase;\n      border: 1px solid var(--black);\n      padding: 5px 12px;\n      margin-right: 6px;\n      margin-bottom: 6px;\n    }\n\n    \/* ── QUALITY GRID — 3 columns ── *\/\n    .ap-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      border-top: 1px solid var(--black);\n      border-left: 1px solid var(--black);\n      margin-bottom: 0;\n    }\n\n    .ap-card {\n      border-right: 1px solid var(--black);\n      border-bottom: 1px solid var(--black);\n      padding: 36px 28px 32px;\n      position: relative;\n      transition: background 0.25s ease;\n      cursor: default;\n    }\n\n    .ap-card:hover {\n      background: #2a555a;\n    }\n\n    .ap-card:hover .ap-card-num,\n    .ap-card:hover .ap-card-title,\n    .ap-card:hover .ap-card-desc {\n      color: var(--white);\n    }\n\n    .ap-card:hover .ap-card-icon {\n      stroke: var(--white);\n    }\n\n    .ap-card-num {\n      font-size: 11px;\n      letter-spacing: 0.2em;\n      color: var(--gray-400);\n      margin-bottom: 20px;\n      transition: color 0.25s ease;\n    }\n\n    .ap-card-icon {\n      width: 26px;\n      height: 26px;\n      margin-bottom: 16px;\n      stroke: var(--black);\n      stroke-width: 1.1;\n      fill: none;\n      transition: stroke 0.25s ease;\n      display: block;\n    }\n\n    .ap-card-title {\n      font-size: clamp(18px, 2.2vw, 22px);\n      font-weight: 400;\n      line-height: 1.2;\n      color: var(--black);\n      margin-bottom: 10px;\n      transition: color 0.25s ease;\n    }\n\n    .ap-card-desc {\n      font-size: 12.5px;\n      font-weight: 300;\n      line-height: 1.8;\n      color: var(--gray-600);\n      transition: color 0.25s ease;\n    }\n\n    \/* ── STAT BAND ── *\/\n    .ap-stats {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      border-left: 1px solid var(--black);\n      border-right: 1px solid var(--black);\n      border-bottom: 1px solid var(--black);\n    }\n\n    .ap-stat {\n      padding: 28px 20px;\n      text-align: center;\n      border-right: 1px solid var(--black);\n    }\n\n    .ap-stat:last-child {\n      border-right: none;\n    }\n\n    .ap-stat-val {\n      display: block;\n      font-size: clamp(26px, 4vw, 38px);\n      font-weight: 300;\n      line-height: 1;\n      color: var(--black);\n    }\n\n    .ap-stat-label {\n      display: block;\n      font-size: 10px;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: var(--gray-400);\n      margin-top: 6px;\n    }\n\n    \/* ── FULL-WIDTH FEATURE STRIP ── *\/\n    .ap-strip {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      margin-top: 48px;\n      gap: 1px;\n      background: var(--black);\n    }\n\n    .ap-strip-block {\n      background: var(--white);\n      padding: 40px 36px;\n    }\n\n    .ap-strip-block-dark {\n      background: #2A555A;\n      color: var(--white);\n      padding: 40px 36px;\n    }\n\n    .ap-strip-label {\n      font-size: 10px;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      color: var(--gray-400);\n      margin-bottom: 16px;\n    }\n\n    .ap-strip-block-dark .ap-strip-label {\n      color: var(--gray-400);\n    }\n\n    .ap-strip-heading {\n      font-size: clamp(22px, 3vw, 30px);\n      font-weight: 300;\n      line-height: 1.25;\n      color: var(--black);\n      margin-bottom: 12px;\n    }\n\n    .ap-strip-block-dark .ap-strip-heading {\n      color: var(--white);\n    }\n\n    .ap-strip-body {\n      font-size: 13px;\n      font-weight: 300;\n      line-height: 1.8;\n      color: var(--gray-600);\n    }\n\n    .ap-strip-block-dark .ap-strip-body {\n      color: var(--gray-400);\n    }\n\n    \/* ── CARE SECTION ── *\/\n    .ap-care {\n      margin-top: 48px;\n      display: flex;\n      align-items: flex-start;\n      gap: 28px;\n      border-top: 1px solid var(--gray-200);\n      padding-top: 28px;\n    }\n\n    .ap-care-label {\n      font-size: 10px;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: var(--gray-400);\n      white-space: nowrap;\n      padding-top: 5px;\n    }\n\n    .ap-care-chips {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n\n    .ap-chip {\n      font-size: 11px;\n      font-weight: 300;\n      letter-spacing: 0.06em;\n      color: var(--gray-600);\n      border: 1px solid var(--gray-200);\n      padding: 5px 12px;\n    }\n\n    \/* ── FOOTER ── *\/\n    .ap-footer {\n      margin-top: 40px;\n      padding-top: 20px;\n      border-top: 1px solid var(--black);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .ap-sig {\n      font-size: 15px;\n      font-style: italic;\n      font-weight: 300;\n      color: var(--black);\n    }\n\n    .ap-made-in {\n      font-size: 10px;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      color: var(--gray-400);\n    }\n\n    \/* ══════════════════════════════════════\n       SCROLL-IN ANIMATION\n    ══════════════════════════════════════ *\/\n    .reveal {\n      opacity: 0;\n      transform: translateY(18px);\n      transition: opacity 0.55s ease, transform 0.55s ease;\n    }\n\n    .reveal.in {\n      opacity: 1;\n      transform: translateY(0);\n    }\n\n    \/* ══════════════════════════════════════\n       RESPONSIVE — TABLET\n    ══════════════════════════════════════ *\/\n    @media (max-width: 860px) {\n      .ap { padding: 60px 20px 40px; }\n\n      .ap-header {\n        grid-template-columns: 1fr;\n        gap: 28px;\n        margin-bottom: 44px;\n      }\n\n      .ap-header-right {\n        padding-left: 0;\n        border-left: none;\n        border-top: 1px solid var(--gray-200);\n        padding-top: 24px;\n      }\n\n      .ap-grid {\n        grid-template-columns: repeat(2, 1fr);\n      }\n\n      .ap-stats {\n        grid-template-columns: repeat(2, 1fr);\n      }\n\n      .ap-stat:nth-child(2) {\n        border-right: none;\n      }\n\n      .ap-stat:nth-child(3) {\n        border-right: 1px solid var(--black);\n        border-top: 1px solid var(--black);\n      }\n\n      .ap-stat:nth-child(4) {\n        border-right: none;\n        border-top: 1px solid var(--black);\n      }\n\n      .ap-strip {\n        grid-template-columns: 1fr;\n      }\n    }\n\n    \/* ══════════════════════════════════════\n       RESPONSIVE — MOBILE\n    ══════════════════════════════════════ *\/\n    @media (max-width: 540px) {\n      .ap { padding: 40px 16px 32px; }\n\n      .ap-header { margin-bottom: 32px; padding-top: 32px; }\n\n      .ap-grid {\n        grid-template-columns: 1fr;\n      }\n\n      .ap-card { padding: 28px 20px; }\n\n      .ap-stats {\n        grid-template-columns: repeat(2, 1fr);\n      }\n\n      .ap-stat {\n        padding: 20px 12px;\n      }\n\n      .ap-strip-block,\n      .ap-strip-block-dark {\n        padding: 28px 20px;\n      }\n\n      .ap-care {\n        flex-direction: column;\n        gap: 12px;\n      }\n\n      .ap-footer {\n        flex-direction: column;\n        align-items: flex-start;\n        gap: 6px;\n      }\n    }\n  <\/style>\n<\/head>\n<body>\n\n  <!-- ══════════════════════════════════════\n       A+ SECTION\n  ══════════════════════════════════════ -->\n  <section class=\"ap\" aria-label=\"Product quality highlights\">\n\n    <!-- QUALITY GRID — 3 boxes -->\n    <div class=\"ap-grid\">\n\n      <div class=\"ap-card reveal\">\n        <div class=\"ap-card-num\">01<\/div>\n        <svg class=\"ap-card-icon\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n          <path d=\"M6 4h16v2l-2 2H8L6 6V4z\"\/>\n          <line x1=\"9\" y1=\"8\" x2=\"9\" y2=\"24\"\/>\n          <line x1=\"19\" y1=\"8\" x2=\"19\" y2=\"24\"\/>\n          <path d=\"M9 16h10\"\/>\n          <path d=\"M6 4v20M22 4v20\"\/>\n        <\/svg>\n        <div class=\"ap-card-title\">Designed in-house<\/div>\n        <div class=\"ap-card-desc\">Every silhouette starts as a sketch. We design for real women, for how a sleeve falls, how a hem sits when you're actually wearing it.<\/div>\n      <\/div>\n\n      <div class=\"ap-card reveal\">\n        <div class=\"ap-card-num\">02<\/div>\n        <svg class=\"ap-card-icon\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n          <rect x=\"4\" y=\"12\" width=\"8\" height=\"12\" rx=\"1\"\/>\n          <rect x=\"16\" y=\"7\" width=\"8\" height=\"17\" rx=\"1\"\/>\n          <line x1=\"4\" y1=\"24\" x2=\"24\" y2=\"24\"\/>\n        <\/svg>\n        <div class=\"ap-card-title\">Small-batch production<\/div>\n        <div class=\"ap-card-desc\">We produce in limited quantities so every piece receives full attention. When a batch is gone, it's gone — we don't restock at the cost of quality.<\/div>\n      <\/div>\n\n      <div class=\"ap-card reveal\">\n        <div class=\"ap-card-num\">03<\/div>\n        <svg class=\"ap-card-icon\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n          <polyline points=\"4,14 10,20 24,8\"\/>\n          <circle cx=\"14\" cy=\"14\" r=\"11\"\/>\n        <\/svg>\n        <div class=\"ap-card-title\">Hand-checked before it ships<\/div>\n        <div class=\"ap-card-desc\">Every piece is inspected before it leaves the atelier. If it doesn't meet our standard, it doesn't go out — simple as that.<\/div>\n      <\/div>\n\n    <\/div>\n\n    <!-- STAT BAND -->\n   <div class=\"ap-stats reveal\">\n  <div class=\"ap-stat\">\n    <span class=\"ap-stat-val\">Handcrafted<\/span>\n    <span class=\"ap-stat-label\">Detail Work, Every Piece<\/span>\n  <\/div>\n  <div class=\"ap-stat\">\n    <span class=\"ap-stat-val\">Small<\/span>\n    <span class=\"ap-stat-label\">Batch Every Time<\/span>\n  <\/div>\n  <div class=\"ap-stat\">\n    <span class=\"ap-stat-val\">Limited<\/span>\n    <span class=\"ap-stat-label\">Once It's Gone, It's Gone<\/span>\n  <\/div>\n  <div class=\"ap-stat\">\n    <span class=\"ap-stat-val\">Yours<\/span>\n    <span class=\"ap-stat-label\">Inspected Before It Reaches You<\/span>\n  <\/div>\n<\/div>\n\n    <!-- FEATURE STRIP -->\n    <div class=\"ap-strip reveal\">\n      <div class=\"ap-strip-block\">\n        <div class=\"ap-strip-label\">Fit Philosophy<\/div>\n        <div class=\"ap-strip-heading\">Designed for how<br>a piece feels.<\/div>\n        <div class=\"ap-strip-body\">\n          We design for how a piece feels on a real body, not just how it photographs. Every silhouette is tested for ease of movement, drape, and proportion across our full size range.<br><br>\n          Sizes run S to XXL. If you're unsure about fit, write to us before you order. We're happy to help.\n        <\/div>\n      <\/div>\n      <div class=\"ap-strip-block-dark\">\n        <div class=\"ap-strip-label\">A Note on Variation<\/div>\n        <div class=\"ap-strip-heading\">Never a copy.<br>Always yours.<\/div>\n        <div class=\"ap-strip-body\">\n          Because we work with natural fabrics and human hands, slight variation in colour, texture, and finish is expected and intentional. Your piece will look close to the product photos, but it will never be a copy of them.<br><br>\n          That's the point.\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- CARE -->\n    <div class=\"ap-care reveal\">\n      <div class=\"ap-care-label\">Care<\/div>\n      <div class=\"ap-care-chips\">\n        <span class=\"ap-chip\">Dry clean only<\/span>\n        <span class=\"ap-chip\">Wash separately<\/span>\n        <span class=\"ap-chip\">Do not bleach<\/span>\n        <span class=\"ap-chip\">Do not tumble dry<\/span>\n        <span class=\"ap-chip\">Handle with love<\/span>\n      <\/div>\n    <\/div>\n\n  <\/section>\n\n  <script>\n    const els = document.querySelectorAll('.reveal');\n    const io = new IntersectionObserver((entries) => {\n      entries.forEach((e, i) => {\n        if (e.isIntersecting) {\n          const idx = Array.from(els).indexOf(e.target);\n          setTimeout(() => e.target.classList.add('in'), idx * 80);\n          io.unobserve(e.target);\n        }\n      });\n    }, { threshold: 0.12 });\n    els.forEach(el => io.observe(el));\n  <\/script>\n\n<\/body>\n<\/html>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}}},"order":["main","product-recommendations","collection_links_9Pc4EL","hero_UwEeDF","custom_liquid_yjfVMm"]}